#!/usr/bin/env python3
# Safe worktree cleanup (spec #156, ticket spec #172). Standard library only.
#   cleanup [--skip-ownership] [--base <branch>] <worktree path>
# Runs checks 1 (Target), 2 (Ownership), 3 (Clean), 4 (Submodules pushed), 5 (Merged), 6 (Pushed), 7 (Main checkout) and 8 (Docker),
# then the section 8 after-merge actions: remote branch delete, main-checkout switch and pull, `orca worktree rm --force`, local branch delete.
# Check 5 also passes, with no merged PR, a tip that is on origin/<base> after a fetch (#300); <base> is --base or the default branch.
# It also passes when every file the branch changes is the same on origin/<base>, or when a merged PR's head contains the tip
# (a squash-merged coordinator PR, #787); that PR's base is then used.
# A merged PR at the tip takes precedence: its base is used and --base is ignored.
# Exit codes: 0 every step done; 1 usage error or refusal, nothing changed; 2 an action failed (done steps reported).
import os
import sys
import time

from ownership import (BRANCH_PREFIX, REMOTE, SKIP_COMMAND, anchor_worktree, bound_run, check_clean, check_docker, check_ownership,
                       ancestor_problem, default_branch, failure_text, fetch_base, git, read_json, remote_ref_sha, row_worktree, run,
                       run_proof)

DEVELOPMENT = "develop"
USAGE = "Usage: cleanup [--skip-ownership] [--base <branch>] <worktree path>"
PROTECTED = ("develop", "main")
SETTLED_STATES = ("succeeded", "failed", "abandoned", "stopped")
DEFAULT_WAIT_INTERVAL = 1.0
DEFAULT_WAIT_LIMIT = 60.0


class ActionFailed(Exception):
    pass


def say(line):
    print(line, flush=True)


def seconds(name, default):
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        value = float(raw)
    except ValueError:
        return None
    return value if value > 0 else None


def parse(argv):
    skip = False
    base = None
    paths = []
    args = iter(argv)
    for arg in args:
        if arg == "--skip-ownership":
            skip = True
        elif arg == "--base" and base is None:
            base = next(args, "")
            if not base or base.startswith("-"):
                return None
        elif arg.startswith("-"):
            return None
        else:
            paths.append(arg)
    if len(paths) != 1:
        return None
    return skip, base, paths[0]


def worktree_paths(repo):
    """The paths of `git worktree list --porcelain`, the main checkout first."""
    lines = git(repo, "worktree", "list", "--porcelain").stdout.splitlines()
    return [line[len("worktree "):] for line in lines if line.startswith("worktree ")]


def check_target(target):
    """Return (reasons, facts). Facts hold the branch, main checkout and Orca worktree record when the check passes."""
    top = git(target, "rev-parse", "--show-toplevel")
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != target:
        return ["Target: not the root folder of a git worktree"], None
    paths = worktree_paths(target)
    checkout = paths[0] if paths else None
    if checkout is None or os.path.realpath(checkout) == target:
        return ["Target: the main checkout, not a linked worktree"], None
    branch = git(target, "symbolic-ref", "--short", "-q", "HEAD")
    if branch.returncode != 0 or not branch.stdout.strip():
        return ["Target: no branch is checked out (detached HEAD)"], None
    shown = read_json(run("orca", "worktree", "show", "--worktree", f"path:{target}", "--json"))
    record = shown.get("result", {}).get("worktree") if isinstance(shown, dict) and shown.get("ok") else None
    if not isinstance(record, dict) or not record.get("id"):
        return ["Target: Orca does not know this worktree"], None
    return [], {"branch": branch.stdout.strip(), "checkout": os.path.realpath(checkout), "record": record}


def check_active(run_id, rows, worktree_id):
    """The refusals of the bound Run: its list is not read in full, or a Dispatch on the target is not settled."""
    if run_id is None:
        return []
    if rows is None:
        return [f"Bound Run: cannot check run {run_id} for an active worker, its worker list was not read in full"]
    active = [row["dispatchId"] if isinstance(row.get("dispatchId"), str) else "(no id)"
              for row in rows if row_worktree(row) == worktree_id and row.get("workerState") not in SETTLED_STATES]
    if active:
        return [f"Active worker: Dispatch {', '.join(active)} is still active on this worktree; release the worker first"]
    return []


def check_submodules(target):
    """Check 4: every initialized submodule has its HEAD on a remote-tracking branch, after a fetch."""
    listing = git(target, "ls-files", "-s", "-z")
    if listing.returncode != 0:
        return [f"Submodules pushed: git ls-files failed: {failure_text(listing)}"]
    reasons = []
    for entry in listing.stdout.split("\0"):
        meta, _, path = entry.partition("\t")
        folder = os.path.join(target, path)
        if not meta.startswith("160000 ") or not os.path.exists(os.path.join(folder, ".git")):
            continue
        fetch = git(folder, "fetch")
        if fetch.returncode != 0:
            reasons.append(f"Submodules pushed: {path}: fetch failed: {failure_text(fetch)}")
            continue
        contains = git(folder, "branch", "-r", "--contains", "HEAD")
        if contains.returncode != 0:
            reasons.append(f"Submodules pushed: {path}: listing the remote branches of HEAD failed: {failure_text(contains)}")
        elif not contains.stdout.strip():
            reasons.append(f"Submodules pushed: {path}: HEAD is on no remote-tracking branch")
    return reasons


def check_merged(target, branch, tip, named_base):
    """Return (reasons, base, default, numbers). Numbers are those of the merged PRs at the tip, [] when the tip is on
    origin/<base> with no merged PR, None when the check fails."""
    prs = read_json(run("gh", "pr", "list", "--head", branch, "--state", "merged",
                        "--json", "number,headRefOid,baseRefName", cwd=target))
    if not isinstance(prs, list):
        return ["Merged: could not read the merged PRs from GitHub"], None, None, None
    matching = [pr for pr in prs if isinstance(pr, dict) and pr.get("headRefOid") == tip]
    bases = {pr.get("baseRefName") for pr in matching}
    if len(bases) > 1:
        return ["Merged: matching PRs have different base branches, the base cannot be chosen"], None, None, None
    default = default_branch(target)
    if not default:
        return ["Merged: could not read the default branch from GitHub"], None, None, None
    if bases:
        return [], bases.pop(), default, sorted(pr["number"] for pr in matching if isinstance(pr.get("number"), int))
    base = named_base or default
    problem = fetch_base(target, base)
    if problem is None:
        problem = ancestor_problem(target, tip, base)
        if problem and changes_on_base(target, tip, base):
            return [], base, default, []
    if not problem:
        return [], base, default, []
    containing = containing_pr_bases(target, tip)
    if containing is None:
        problem += "; the search for a merged PR that contains it failed"
    elif len(containing) > 1:
        return ["Merged: merged PRs that contain the tip have different base branches, the base cannot be chosen"], None, None, None
    elif containing:
        return [], containing.pop(), default, []
    return [f"Merged: no merged PR has the local tip {tip[:12]} as its head or contains it, and {problem}"], None, None, None


def changes_on_base(target, tip, base):
    """True when every file that the branch changes since its fork point is the same on the fetched origin/<base>,
    so the base already holds the branch's work, for example after a redundant PR was closed (#787)."""
    ref = f"refs/remotes/{REMOTE}/{base}"
    fork = git(target, "merge-base", tip, ref)
    if fork.returncode != 0:
        return False
    names = git(target, "diff", "--no-renames", "--name-only", "-z", fork.stdout.strip(), tip)
    if names.returncode != 0:
        return False
    paths = [path for path in names.stdout.split("\0") if path]
    if not paths:
        return True
    return git(target, "--literal-pathspecs", "diff", "--quiet", ref, tip, "--", *paths).returncode == 0


def containing_pr_bases(target, tip):
    """The base branches of the merged PRs whose head commit has the tip as an ancestor, as when a coordinator branch
    that merged this branch was squash-merged (#787). None when GitHub cannot be read."""
    prs = read_json(run("gh", "pr", "list", "--state", "merged", "--search", tip,
                        "--json", "number,headRefOid,baseRefName", cwd=target))
    if not isinstance(prs, list):
        return None
    bases = set()
    for pr in prs:
        number, head, base = (pr.get(key) if isinstance(pr, dict) else None for key in ("number", "headRefOid", "baseRefName"))
        if not (isinstance(number, int) and isinstance(head, str) and isinstance(base, str)):
            continue
        fetch = git(target, "fetch", REMOTE, f"refs/pull/{number}/head")
        if fetch.returncode != 0 or git(target, "rev-parse", "FETCH_HEAD").stdout.strip() != head:
            continue
        if git(target, "merge-base", "--is-ancestor", tip, head).returncode == 0:
            bases.add(base)
    return bases


def check_pushed(target, branch, tip, numbers):
    """Return (reasons, branch_ref_absent)."""
    sha, error = remote_ref_sha(target, f"{BRANCH_PREFIX}{branch}")
    if error:
        return [f"Pushed: could not read {REMOTE}: {error}"], False
    if sha == tip:
        return [], False
    if sha:
        return [f"Pushed: {REMOTE} has {branch} at {sha[:12]}, not the local tip {tip[:12]}. "
                f"The local branch is ahead of or differs from {REMOTE}: push it, or reset it to the {REMOTE} tip, then run cleanup again"], False
    if numbers is None:
        return [f"Pushed: {branch} is absent on {REMOTE} and check 5 failed, so no merged PR gives a pull ref to compare"], True
    if not numbers:
        return [], True  # the tip is on the fetched base, so no pull ref is needed (#300)
    problem = None
    for number in numbers:
        pull, error = remote_ref_sha(target, f"refs/pull/{number}/head")
        if pull == tip:
            return [], True
        if error:
            problem = f"could not read the pull ref of PR {number}: {error}"
        else:
            problem = f"the pull ref of PR {number} is {(pull or 'absent')[:12]}, not the local tip {tip[:12]}"
    return [f"Pushed: {branch} is absent on {REMOTE} and {problem}"], True


def switch_target(target, checkout, default):
    """Return (branch, reasons). The main checkout returns to develop when origin has it, else to the default branch.
    Every check that the switch and pull need runs here, because act() deletes the remote branch before it switches."""
    sha, error = remote_ref_sha(target, f"{BRANCH_PREFIX}{DEVELOPMENT}")
    if error:
        return None, [f"Main checkout: could not read {REMOTE}/{DEVELOPMENT}: {error}"]
    branch = DEVELOPMENT if sha else default
    problem = fetch_base(target, branch)
    if problem:
        return None, [f"Main checkout: {problem}"]
    elsewhere = checked_out_elsewhere(checkout, branch)
    if elsewhere:
        return None, [f"Main checkout: {branch} is checked out in another worktree ({elsewhere})"]
    if git(checkout, "show-ref", "--verify", "--quiet", f"{BRANCH_PREFIX}{branch}").returncode == 0:
        local, remote = f"{BRANCH_PREFIX}{branch}", f"refs/remotes/{REMOTE}/{branch}"
        # pull --ff-only works when the local branch is behind origin, and does nothing when it is ahead; it fails on a divergence
        results = [git(checkout, "merge-base", "--is-ancestor", *refs) for refs in ((local, remote), (remote, local))]
        for result in results:
            if result.returncode > 1:
                return None, [f"Main checkout: git merge-base failed: {failure_text(result)}"]
        if all(result.returncode == 1 for result in results):
            return None, [f"Main checkout: local {branch} and {REMOTE}/{branch} have diverged, so pull --ff-only would fail"]
    return branch, []


def checked_out_elsewhere(checkout, branch):
    """The path of a worktree other than the main checkout that has the branch checked out, else None."""
    path = None
    for line in git(checkout, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line == f"branch {BRANCH_PREFIX}{branch}" and os.path.realpath(path) != os.path.realpath(checkout):
            return path
    return None


def check_main_checkout(checkout):
    status = git(checkout, "status", "--porcelain", "--untracked-files=no")
    if status.returncode != 0:
        return [f"Main checkout: git status failed: {failure_text(status)}"]
    if status.stdout.strip():
        return ["Main checkout: it has uncommitted changes to tracked files"]
    result = git(checkout, "rev-parse", "--git-dir")
    if result.returncode != 0:
        return [f"Main checkout: git rev-parse --git-dir failed: {failure_text(result)}"]
    git_dir = os.path.join(checkout, result.stdout.strip())
    for name in ("MERGE_HEAD", "rebase-merge", "rebase-apply"):
        if os.path.exists(os.path.join(git_dir, name)):
            return [f"Main checkout: a merge or rebase is in progress ({name})"]
    return []


def remote_ref_present(target, branch):
    sha, error = remote_ref_sha(target, f"{BRANCH_PREFIX}{branch}")
    if error:
        raise ActionFailed(f"Remote branch: could not read {REMOTE}: {error}")
    return bool(sha)


def delete_remote_branch(target, branch, protected, ref_absent):
    if protected:
        return "skipped, protected branch"
    if ref_absent:
        return "skipped, no remote ref"
    pushed = git(target, "push", REMOTE, "--delete", branch)
    if pushed.returncode == 0:
        return "deleted"
    if not remote_ref_present(target, branch):
        return "already gone"
    raise ActionFailed(f"Remote branch: delete failed: {failure_text(pushed)}")


def switch_and_pull(checkout, base):
    # pull names the remote branch, so a local branch without an upstream pulls too
    for args in (("switch", base), ("pull", "--ff-only", REMOTE, base)):
        result = git(checkout, *args)
        if result.returncode != 0:
            raise ActionFailed(f"Switch and pull: git {args[0]} failed: {failure_text(result)}")


def remove_worktree(target):
    result = run("orca", "worktree", "rm", "--worktree", f"path:{target}", "--force", "--json")
    shown = read_json(result)
    if result.returncode != 0 or (isinstance(shown, dict) and shown.get("ok") is False):
        raise ActionFailed(f"Worktree: orca worktree rm failed: {failure_text(result)}")


def wait_for_removal(checkout, target, interval, limit):
    deadline = time.monotonic() + limit
    while os.path.exists(target) or target in worktree_paths(checkout):
        if time.monotonic() >= deadline:
            raise ActionFailed(f"Worktree: still present after {limit:g} s")
        time.sleep(interval)


def delete_local_branch(checkout, branch):
    if git(checkout, "show-ref", "--verify", "--quiet", f"{BRANCH_PREFIX}{branch}").returncode != 0:
        return "already gone"
    result = git(checkout, "branch", "-D", branch)
    if result.returncode != 0:
        raise ActionFailed(f"Local branch: delete failed: {failure_text(result)}")
    return "deleted"


def act(target, facts, switch_to, default, ref_absent, own, interval, limit):
    branch, checkout = facts["branch"], facts["checkout"]
    done = []

    def step(name, outcome):
        done.append(name)
        say(f"{name}: {outcome}")

    try:
        step("Remote branch", delete_remote_branch(target, branch, branch in PROTECTED or branch == default, ref_absent))
        switch_and_pull(checkout, switch_to)
        step("Switch and pull", f"{switch_to} pulled with --ff-only")
        if own:
            say("Terminal closes: the worktree of this session is removed as the last step")
        remove_worktree(target)
        if own:
            say("Worktree: removal requested")
            return 0
        wait_for_removal(checkout, target, interval, limit)
        step("Worktree", "removed")
        step("Local branch", delete_local_branch(checkout, branch))
    except ActionFailed as error:
        say(str(error))
        say("Done steps: " + (", ".join(done) or "none"))
        return 2
    return 0


def refuse(reasons):
    for reason in reasons:
        say(reason)
    return 1


def main(argv):
    parsed = parse(argv)
    interval = seconds("WORKTREE_CLEANUP_WAIT_INTERVAL", DEFAULT_WAIT_INTERVAL)
    limit = seconds("WORKTREE_CLEANUP_WAIT_LIMIT", DEFAULT_WAIT_LIMIT)
    if parsed is None or interval is None or limit is None:
        say(USAGE)
        return 1
    skip, named_base, path = parsed
    target = os.path.realpath(path)
    reasons, facts = check_target(target)
    if reasons:
        return refuse(reasons)
    handle = os.environ.get("ORCA_TERMINAL_HANDLE", "")
    anchor = anchor_worktree(handle)
    record = facts["record"]
    run_id, rows = bound_run()
    blockers = check_active(run_id, rows, record["id"])
    reasons = [] if skip else check_ownership(record, anchor, handle)
    run_only = bool(reasons) and run_proof(record["id"], handle, rows)
    if run_only:
        reasons = []
    # The skip command would not lift a blocker, so it is not printed beside one.
    if reasons and not blockers:
        reasons.append(SKIP_COMMAND.format(path=target))
    reasons += blockers
    reasons += check_clean(target)
    reasons += check_submodules(target)
    tip = git(target, "rev-parse", "HEAD").stdout.strip()
    merged, base, default, numbers = check_merged(target, facts["branch"], tip, named_base)
    reasons += merged
    pushed, ref_absent = check_pushed(target, facts["branch"], tip, numbers)
    reasons += pushed
    switch_to = None
    if default:
        switch_to, switch_reasons = switch_target(target, facts["checkout"], default)
        reasons += switch_reasons
    reasons += check_main_checkout(facts["checkout"])
    reasons += check_docker(target)
    if reasons:
        return refuse(reasons)
    own = not run_only and (anchor is None or anchor == record["id"])
    return act(target, facts, switch_to, default, ref_absent, own, interval, limit)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
