def _runtime():
    # Imported on first use, inside the callers' guards, so an import error follows the error rules of the hooks.
    # The real folder goes first on the search path, so that a module of the same name earlier on it cannot win.
    sys.path.insert(0, CONTEXT_HANDOFF_DIR)
    import runtime_dir

    return runtime_dir


def _git(cwd, *args):
    import subprocess  # imported here: the hook's common path never runs git

    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, errors="replace", timeout=GIT_TIMEOUT_SECONDS)


def _git_output(cwd, *args, no_result=(1, 128)):
    """The stripped stdout of a git call that succeeded, None for a status that git uses for "no result"
    (1 for a missing ref or a detached HEAD, 128 outside a repository). Any other status raises."""
    result = _git(cwd, *args)
    if result.returncode == 0:
        return result.stdout.strip()
    if result.returncode in no_result:
        return None
    raise RuntimeError(f"git {args[0]} exited with status {result.returncode}: {result.stderr.strip()}")


def _cut(text, limit=EVIDENCE_LIMIT):
    return text if len(text) <= limit else text[: limit - 3] + "..."


CONTINUED_LINE = re.compile(r"(?<!\\)((?:\\\\)*)\\\n")  # a newline after an odd backslash run; an even run is escaped backslashes


def _join_continued(text):
    """The text with each continued line joined, wherever it is. The counts use this: a nested shell (`bash -c '...'`) reads a quoted
    continued line as a join, so joining everywhere can only add to the gated-text count and the gate stays closed."""
    return CONTINUED_LINE.sub(r"\1", text)


def _join_as_bash(text):
    """The text with each continued line joined where bash joins it: not inside single quotes, and not in a comment (a comment ends at
    the newline, so the next line is another command). The gate splits this text, so it reads the words that bash runs."""
    out, index, quote, comment, word_start = [], 0, None, False, True
    while index < len(text):
        char = text[index]
        if comment or quote == "'":
            out.append(char)
            comment = comment and char != "\n"
            quote = None if quote == "'" and char == "'" else quote
        elif char == "\\":
            pair = text[index:index + 2]
            if pair != "\\\n":  # a joined pair is not there for bash, so it leaves word_start as it was
                out.append(pair)
                word_start = False
            index += len(pair)
            continue
        else:
            if quote == '"':
                quote = None if char == '"' else quote
            elif char in "'\"":
                quote = char
            elif char == "#" and word_start:
                comment = True
            out.append(char)
        word_start = char in " \t\n;&|()"
        index += 1
    return "".join(out)


def _normalise(text):
    """The text as the gate counts it: continued lines joined, quote characters removed (so a quoted gated command still counts), and
    a whitespace run is one space."""
    return " ".join(_join_continued(text).replace("'", "").replace('"', "").split())


def _occurrences(text, needle):
    return _normalise(text).count(needle)


# ---- S8: conventional commits without attribution ----

def _attribution_line(message):
    for line in message.splitlines():
        trailer = TRAILER.fullmatch(line)
        if trailer:
            key, value = trailer.group(1).lower(), trailer.group(2)
            if key == "co-authored-by" or (key in ATTRIBUTION_NAMED_KEYS and ATTRIBUTION_NAME.search(value)):
                return line
        if GENERATED_WITH.search(line) or line.lstrip().startswith(ROBOT):
            return line
    return None


def _commit_problem(message):
    header = message.split("\n", 1)[0]
    if not HEADER.match(header):
        return f"header is not conventional: {header[:60]!r}"
    line = _attribution_line(message)
    if line is not None:
        return f"attribution line: {line.strip()[:60]!r}"
    return None


def _commit_base(worktree):
    """(the merge base of HEAD with the remote default branch, None), or (None, why there is none)."""
    default = None
    for ref in ("refs/remotes/origin/HEAD", "refs/remotes/origin/main", "refs/remotes/origin/master"):
        if _git_output(worktree, "rev-parse", "--verify", "-q", ref + "^{commit}"):
            default = ref
            break
    if default is None:
        return None, "evidence unavailable: none of origin/HEAD, origin/main and origin/master exists"
    base = _git_output(worktree, "merge-base", default, "HEAD")
    if not base:
        return None, f"evidence unavailable: no merge base of {default} and HEAD"
    return base, None


def check_s8(worktree):
    """Returns (passed, evidence)."""
    base, why = _commit_base(worktree)
    if base is None:
        return False, why
    log = _git(worktree, "log", "-z", "--format=%H%n%B", f"{base}..HEAD")
    if log.returncode != 0:
        return False, f"evidence unavailable: git log failed: {log.stderr.strip()}"
    commits = [entry for entry in log.stdout.split("\0") if entry.strip()]
    problems = []
    for entry in commits:
        sha, _, message = entry.strip("\n").partition("\n")
        problem = _commit_problem(message)
        if problem:
            problems.append(f"{sha[:7]}: {problem}")
    if not problems:
        return True, f"{len(commits)} commits since {base[:7]}, all conventional, no attribution"
    shown = problems[:10]
    if len(problems) > 10:
        shown.append(f"and {len(problems) - 10} more")
    return False, _cut("\n".join(shown))


# ---- transcript reader: S1 and S2 ----

class Unavailable(Exception):
    """The evidence cannot be read: the affected items fail with "evidence unavailable: <reason>"."""

    def __str__(self):
        return f"evidence unavailable: {self.args[0]}"


def _inside(path, root):
    return path == root or path.startswith(root.rstrip("/") + "/")


def _instant(value, where):
    from datetime import datetime, timezone

    try:
        moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        raise Unavailable(f"missing or bad timestamp in {where}")
    return moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)


class Transcript:
    """The rows of one transcript file that S1 and S2 read."""

    def __init__(self, name):
        self.name = name
        self.calls = []      # dicts: index, tool, id, time, path or command, background, cwd
        self.results = {}    # tool_use_id -> list of is_error booleans
        self.notices = []    # texts that hold a task notification
        self.prompts = []    # texts of the user rows, never of a tool_result block or a compaction summary
        self.launches = []   # (Agent or Skill, the fields the digest shows) of the tool_use blocks; never read by an S item
        self.cwds = set()
        self.versions = set()
        self.models = set()  # the message.model of the assistant rows, None when it is not a string
        self.start = None    # the time of the first user or assistant row, None when it has no readable time
        self.start_seen = False


def _check_version(row, where):
    version = row.get("version")
    match = VERSION.fullmatch(version) if isinstance(version, str) else None
    if not match:  # the value itself is row content and stays out of the evidence
        raise Unavailable(f"missing or malformed Claude Code version in {where}")
    if match.groups()[:2] not in TESTED_MAJOR_MINOR:
        raise Unavailable(f"untested Claude Code version {version} in {where}")
    return version


def _text_blocks(content):
    if isinstance(content, str):
        return [content]
    return [block["text"] for block in content if block.get("type") == "text" and isinstance(block.get("text"), str)]


def _read_row(transcript, index, row):
    where = f"{transcript.name} row {index + 1}"
    if not isinstance(row, dict) or not isinstance(row.get("type"), str):
        raise Unavailable(f"unknown row shape in {where}")
    kind = row["type"]
    if kind not in READ_KINDS:
        return
    transcript.versions.add(_check_version(row, where))
    if isinstance(row.get("cwd"), str):
        transcript.cwds.add(row["cwd"])
    if kind == "attachment":
        attachment = row.get("attachment")
        if isinstance(attachment, dict) and attachment.get("type") == "queued_command" and isinstance(attachment.get("prompt"), str):
            transcript.notices.append(attachment["prompt"])
        return
    if kind == "system":
        return
    if not transcript.start_seen:
        transcript.start_seen = True
        try:
            transcript.start = _instant(row.get("timestamp"), where)
        except Unavailable:
            pass  # a ledger check that needs the start time reports it as unavailable
    message = row.get("message")
    if not isinstance(message, dict):
        raise Unavailable(f"missing message in {where}")
    content = message.get("content")
    # Claude Code writes a compaction summary; no one sent it, so it is not a prompt
    is_summary = row.get("isCompactSummary") is True
    if isinstance(content, str) and kind == "user":
        blocks = []
        transcript.notices.append(content)
        if not is_summary:
            transcript.prompts.append(content)
    elif isinstance(content, list) and all(isinstance(block, dict) and isinstance(block.get("type"), str) for block in content):
        blocks = content
        if kind == "user":  # a notification is read from user and attachment rows only
            texts = _text_blocks(content)
            transcript.notices.extend(texts)
            if not is_summary:
                transcript.prompts.extend(texts)
    else:
        raise Unavailable(f"unknown content shape in {where}")
    if kind == "assistant":
        model = message.get("model")
        transcript.models.add(model if isinstance(model, str) else None)
    for block in blocks:
        if kind == "user" and block["type"] == "tool_result":
            if not isinstance(block.get("tool_use_id"), str) or not isinstance(block.get("is_error", False), bool):
                raise Unavailable(f"bad tool_result in {where}")
            transcript.results.setdefault(block["tool_use_id"], []).append(block.get("is_error", False))
        elif kind == "assistant" and block["type"] == "tool_use":
            if not isinstance(block.get("id"), str) or not isinstance(block.get("name"), str) or not isinstance(block.get("input"), dict):
                raise Unavailable(f"bad tool_use in {where}")
            name, tool_input = block["name"], block["input"]
            if name in LAUNCH_FIELDS:
                transcript.launches.append((name, [tool_input.get(key) if isinstance(tool_input.get(key), str) else None for key in LAUNCH_FIELDS[name]]))
                continue
            if name not in EDIT_TOOLS and name != "Bash":
                continue
            call = {"index": index, "tool": name, "id": block["id"], "time": _instant(row.get("timestamp"), where),
                    "cwd": row.get("cwd") if isinstance(row.get("cwd"), str) else None}
            if name == "Bash":
                if not isinstance(tool_input.get("command"), str):
                    raise Unavailable(f"missing command in {where}")
                call["command"] = tool_input["command"]
                call["background"] = tool_input.get("run_in_background") is True
            else:
                keys = ("file_path", "notebook_path") if name == "NotebookEdit" else ("file_path",)
                path = next((tool_input[key] for key in keys if isinstance(tool_input.get(key), str) and tool_input[key]), None)
                if path is None:
                    raise Unavailable(f"missing {keys[0]} in {where}")
                if not os.path.isabs(path):
                    if call["cwd"] is None:
                        raise Unavailable(f"relative path without cwd in {where}")
                    path = os.path.join(call["cwd"], path)
                call["path"] = os.path.realpath(path)
            transcript.calls.append(call)


def _read_transcript(path, text):
    transcript = Transcript(os.path.basename(path))
    for index, line in enumerate(text.split("\n")):  # not splitlines(): U+2028 and others stay inside a row
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except ValueError:
            row = None
        _read_row(transcript, index, row)
    return transcript


def _read_runtime_file(dir_fd, name, what):
    """All bytes of a regular file of the runtime folder, opened without following a symlink; None when it does not exist.
    Raises Unavailable("unreadable <what>") for anything else. Unlike runtime_dir.read_file it has no size limit."""
    import stat

    try:
        file_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError:
        raise Unavailable(f"unreadable {what}")
    try:
        if not stat.S_ISREG(os.fstat(file_fd).st_mode):
            raise Unavailable(f"unreadable {what}")
        with os.fdopen(os.dup(file_fd), "rb") as handle:
            return handle.read()
    except OSError:
        raise Unavailable(f"unreadable {what}")
    finally:
        os.close(file_fd)


def _registered_sessions(dir_fd):
    """(session_id, transcript_path) of each registered session, the first line in file order per id."""
    runtime_dir = _runtime()
    data = _read_runtime_file(dir_fd, SESSIONS_FILE, "registry")
    if data is None:
        return []
    sessions = {}
    for number, line in enumerate(data.decode("utf-8", "replace").split("\n"), 1):
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            entry = None
        if (not isinstance(entry, dict) or not runtime_dir.valid_session_id(entry.get("session_id"))
                or not isinstance(entry.get("transcript_path"), str) or not entry["transcript_path"]
                or not isinstance(entry.get("started_at"), str)):
            raise Unavailable(f"unreadable registry line {number}")
        sessions.setdefault(entry["session_id"], entry["transcript_path"])
    return list(sessions.items())


def _touches(transcript, spellings, root):
    for call in transcript.calls:
        if call["tool"] == "Bash":
            if any(re.search(re.escape(spelling) + r"(?![A-Za-z0-9._-])", call["command"]) for spelling in spellings):
                return True
        elif _inside(call["path"], root):
            return True
    return any(_inside(os.path.realpath(cwd), root) for cwd in transcript.cwds)


def _audited_transcripts(worktree, dir_fd):
    """The transcripts of every registered session that touches the worktree, and the versions read.
    A session whose main transcript is missing (ENOENT), and a subagent file that is missing, are skipped.
    Raises Unavailable when no session touches it or another read error occurs."""
    root = os.path.realpath(worktree)
    spellings = {os.path.abspath(worktree), root}
    needles = {text for spelling in spellings for text in (spelling, json.dumps(spelling)[1:-1])}
    sessions = _registered_sessions(dir_fd)
    if not sessions:
        raise Unavailable("no registered session (empty or wiped registry)")
    audited = []
    for _, path in sessions:
        folder = os.path.splitext(path)[0] + "/subagents"
        paths = [path]
        if os.path.isdir(folder):
            paths += sorted(os.path.join(folder, name) for name in os.listdir(folder) if re.fullmatch(r"agent-.+\.jsonl", name))
        texts = {}
        for file_path in paths:
            try:
                with open(file_path, "rb") as handle:
                    texts[file_path] = handle.read().decode("utf-8", "replace")
            except FileNotFoundError:
                if file_path == path:  # the main transcript is paths[0], so no subagent text is held yet
                    break  # a session that never wrote its transcript cannot have touched the worktree
                continue  # a subagent file listed and then removed
            except OSError as error:
                raise Unavailable(f"cannot read transcript {os.path.basename(file_path)}: {error.strerror}")
        if not any(needle in text for text in texts.values() for needle in needles):
            continue  # speed rule: a transcript that never holds the path cannot touch the worktree
        transcripts = [_read_transcript(file_path, text) for file_path, text in texts.items()]
        if any(_touches(transcript, spellings, root) for transcript in transcripts):
            audited.append(transcripts)
    if not audited:
        raise Unavailable("no registered session touches the worktree")
    return audited


def _versions_note(audited):
    versions = sorted({v for transcripts in audited for t in transcripts for v in t.versions} - set(TESTED_VERSIONS))
    return "".join(f"; untested patch version {version}" for version in versions)


def _main_checkout(worktree):
    try:
        listing = _git_output(worktree, "worktree", "list", "--porcelain")
    except RuntimeError as problem:
        raise Unavailable(str(problem))
    paths = [os.path.realpath(line[len("worktree "):]) for line in (listing or "").splitlines() if line.startswith("worktree ")]
    if not paths:
        raise Unavailable("git worktree list gave no worktree")
    return paths[0], paths[1:]


def check_s1(worktree, audited):
    """Returns (passed, evidence)."""
    root = os.path.realpath(worktree)
    main, others = _main_checkout(worktree)
    if root == main:
        return False, "the audited worktree is the main checkout"
    found = [f"{t.name}: {c['path']}" for transcripts in audited for t in transcripts for c in t.calls
             if c["tool"] in EDIT_TOOLS and _inside(c["path"], main) and not any(_inside(c["path"], other) for other in others)]
    if not found:
        return True, f"{len(audited)} sessions audited, no edit in the main checkout"
    shown = found[:10]
    if len(found) > 10:
        shown.append(f"and {len(found) - 10} more")
    return False, "\n".join(shown)


def _declaration_text(worktree, path):
    listed = _git(worktree, "ls-tree", "HEAD", "--", path)
    if listed.returncode != 0:
        raise Unavailable(f"git ls-tree failed for {path}: {listed.stderr.strip()}")
    if not listed.stdout.strip():
        return None
    shown = _git(worktree, "show", f"HEAD:{path}")
    if shown.returncode != 0:
        raise Unavailable(f"git show failed for {path}: {shown.stderr.strip()}")
    return shown.stdout


def _sections(text):
    """The fenced blocks (trimmed content) of each `### Test command` section in a markdown text."""
    sections, current, fence, block = [], None, None, None
    for line in text.splitlines():
        ticks = re.match(r"`{3,}", line)
        if fence is not None:
            if ticks and len(ticks.group()) >= fence:
                fence = None
                if current is not None:
                    current.append("\n".join(block).strip())
            elif current is not None:
                block.append(line)
            continue
        if ticks:
            fence, block = len(ticks.group()), []
        elif line.rstrip() == TEST_COMMAND_HEADING:
            current = []
            sections.append(current)
        elif re.match(r"#{1,6} ", line):
            current = None
    if fence is not None and current is not None:
        current.append("\n".join(block).strip())  # a fence that is never closed runs to the end of the file
    return sections


def _declared_command(worktree):
    """The declared test command, or "none". Raises ValueError for a declaration problem."""
    sections = []
    for path in (".claude/CLAUDE.md", "CLAUDE.md"):
        text = _declaration_text(worktree, path)
        if text is not None:
            sections += _sections(text)
    if len(sections) != 1:
        raise ValueError(f"expected exactly one '{TEST_COMMAND_HEADING}' section in .claude/CLAUDE.md and CLAUDE.md, found {len(sections)}")
    if len(sections[0]) != 1 or not sections[0][0]:
        raise ValueError(f"the '{TEST_COMMAND_HEADING}' section needs exactly one non-empty fenced block, found {len(sections[0])}")
    return sections[0][0]


def _is_after(run, run_transcript, edit, edit_transcript):
    if run_transcript is edit_transcript:
        return run["index"] > edit["index"]
    return run["time"] > edit["time"]


def _notification_exit(texts, call_id):
    """None when no notification belongs to the call; else True when every one of them is `completed (exit code 0)`."""
    outcomes = []
    for text in texts:
        for chunk in text.split("<task-notification>")[1:]:
            ids = re.findall(r"<tool-use-id>(.*?)</tool-use-id>", chunk, re.DOTALL)
            if call_id not in [value.strip() for value in ids]:
                continue
            status = re.search(r"<status>(.*?)</status>", chunk, re.DOTALL)
            summary = re.search(r"<summary>(.*?)</summary>", chunk, re.DOTALL)
            if not status or not summary:
                raise Unavailable("a task notification for a declared test run lacks its status or summary")
            outcomes.append(status.group(1).strip() == "completed" and re.search(r"\(exit code 0\)\s*$", summary.group(1).strip()) is not None)
    return all(outcomes) if outcomes else None


def check_s2(worktree, audited):
    """Returns (passed, evidence)."""
    try:
        declared = _declared_command(worktree)
    except ValueError as problem:
        return False, str(problem)
    if declared == "none":
        return True, "no tests declared (`none`)"
    root = os.path.realpath(worktree)

    def normalised(call):
        command = call["command"].strip()
        prefix = CD_PREFIX.match(command)
        if prefix:
            target = prefix.group(1).strip("'\"")
            if not os.path.isabs(target) and call["cwd"]:
                target = os.path.join(call["cwd"], target)  # a relative path means the row's cwd, not the audit's
            if os.path.isabs(target) and os.path.realpath(target) == root:
                command = command[prefix.end():].strip()
        return command

    edits, runs = [], []
    for transcripts in audited:
        for transcript in transcripts:
            for call in transcript.calls:
                if call["tool"] in EDIT_TOOLS and _inside(call["path"], root):
                    edits.append((call, transcript))
                elif call["tool"] == "Bash" and declared in call["command"] and normalised(call) == declared:
                    runs.append((call, transcript, transcripts[0]))
    later = 0
    for run, transcript, main in runs:
        if not all(_is_after(run, transcript, edit, edit_transcript) for edit, edit_transcript in edits):
            continue
        later += 1
        if run["background"]:
            texts = list(transcript.notices) + ([] if transcript is main else list(main.notices))
            outcome = _notification_exit(texts, run["id"])
        else:
            results = transcript.results.get(run["id"])
            outcome = None if not results else not any(results)
        if outcome:
            return True, f"declared command ran after the last of {len(edits)} edits"
    if not runs:
        return False, "the declared command did not run"
    if not later:
        return False, "the declared command ran only before the last edit"
    return False, "the declared command ran after the last edit but failed or did not finish"


# ---- ledger: the findings ledger of a repo remote and branch ----

class LedgerError(Exception):
    """An event or a ledger line breaks a rule; the message says which."""


def _matches(pattern):
    return lambda value: isinstance(value, str) and pattern.fullmatch(value) is not None


def _plain_text(limit):
    return lambda value: (isinstance(value, str) and 1 <= len(value) <= limit
                          and not any(ord(char) < 32 or ord(char) == 127 for char in value))


def _valid_reviewers(value):
    return (isinstance(value, list) and 1 <= len(value) <= MAX_REVIEWERS and all(_matches(AGENT_ID)(item) for item in value)
            and len(set(value)) == len(value))


VALID_VALUE = {
    "loop": lambda value: value in LEDGER_LOOPS,
    "phase": lambda value: value in LEDGER_PHASES,
    "round": lambda value: type(value) is int and value >= 1,
    "reviewers": _valid_reviewers,
    "id": _matches(FINDING_ID),
    "finding": _matches(FINDING_ID),
    "verifier": _matches(AGENT_ID),
    "loc": _plain_text(LOC_LIMIT),
    "type": lambda value: value in LEDGER_TYPES,
    "reason": _plain_text(REASON_LIMIT),
    "result": lambda value: value in LEDGER_RESULTS,
    "status": lambda value: value in LEDGER_STATUSES,
    "sha": _matches(SHA),
}


def _check_event_shape(event):
    if not isinstance(event, dict):
        raise LedgerError("an event must be a JSON object")
    kind = event.get("kind")
    if kind not in EVENT_KEYS:
        raise LedgerError("unknown event kind")
    if set(event) != {"kind", "time", *EVENT_KEYS[kind]}:
        raise LedgerError(f"a {kind} event needs exactly the keys kind, time, {', '.join(EVENT_KEYS[kind])}")
    try:
        _instant(event["time"], "the ledger")
    except Unavailable:
        raise LedgerError("bad time")
    for key in EVENT_KEYS[kind]:
        if not VALID_VALUE[key](event[key]):
            raise LedgerError(f"bad {key} in a {kind} event")


class Ledger:
    """The events of a ledger, replayed in file order. `apply` checks an event against the ones before it."""

    def __init__(self):
        self.events = []
        self.rounds = {}        # (loop, phase) -> highest round number
        self.round_events = []  # (position, event) in file order
        self.findings = {}      # id -> {"event": the finding event, "status": latest status or None}
        self.verdicts = []
        self.commits = []       # (position, event)

    def apply(self, event):
        _check_event_shape(event)
        kind, position = event["kind"], len(self.events)
        if kind == "round":
            key = (event["loop"], event["phase"])
            if event["round"] != self.rounds.get(key, 0) + 1:
                raise LedgerError(f"round {event['round']} of {key[0]} {key[1]} does not follow round {self.rounds.get(key, 0)}")
            self.rounds[key] = event["round"]
            self.round_events.append((position, event))
        elif kind == "finding":
            if event["id"] in self.findings:
                raise LedgerError(f"finding {event['id']} exists already")
            if self.rounds.get((event["loop"], event["phase"]), 0) < event["round"]:
                raise LedgerError(f"no round event for round {event['round']} of {event['loop']} {event['phase']}")
            self.findings[event["id"]] = {"event": event, "status": None}
        elif kind == "verdict":
            finding = self.findings.get(event["finding"])
            if finding is None:
                raise LedgerError(f"no finding {event['finding']}")
            if finding["event"]["type"] != "Blocking" or finding["event"]["loop"] != CODE_REVIEW:
                raise LedgerError(f"finding {event['finding']} is not a Blocking finding of the {CODE_REVIEW} loop")
            self.verdicts.append(event)
        elif kind == "status":
            if event["finding"] not in self.findings:
                raise LedgerError(f"no finding {event['finding']}")
            self.findings[event["finding"]]["status"] = event["status"]
        else:
            self.commits.append((position, event))
        self.events.append(event)


def _replay(text):
    ledger = Ledger()
    if not text:
        return ledger
    if not text.endswith("\n"):
        raise LedgerError(f"line {text.count(chr(10)) + 1}: the file does not end with a newline")
    for number, line in enumerate(text[:-1].split("\n"), 1):  # not splitlines(): U+2028 and others stay inside a line
        try:
            if len(line.encode("utf-8")) + 1 > MAX_LEDGER_LINE_BYTES:
                raise LedgerError(f"the line is over {MAX_LEDGER_LINE_BYTES} bytes")
            try:
                event = json.loads(line)
            except (ValueError, RecursionError):
                raise LedgerError("not JSON")
            ledger.apply(event)
        except LedgerError as problem:
            raise LedgerError(f"line {number}: {problem}")
    return ledger


def _ledger_name(remote_url, branch):
    import hashlib

    return "ledger-" + hashlib.sha256(f"{remote_url}\n{branch}".encode("utf-8")).hexdigest()


LEDGER_HELP = """\
events and their flags (every flag is required for its event and refused for the others):
  round         --loop --phase --round <n> --reviewer <agent id> (repeat for each reviewer, 1 to 20, all different)
  finding       --id --loop --phase --round --loc --type --reason
  verdict       --finding <id> --verifier <agent id> --result
  status        --finding <id> --status
  phase-commit  --sha <40 hex>
loop values:  %s
phase values: %s (caps: %s)
A review round is recorded with its `round` event before the findings of that round.
`audit ledger show --worktree <path>` prints every event of the ledger, one compact JSON line each, and writes nothing.
""" % (", ".join(LEDGER_LOOPS), ", ".join(PHASE_CAPS), ", ".join(f"{name} {cap}" for name, cap in PHASE_CAPS.items()))


def _ledger_event(argv):
    import argparse

    class Once(argparse.Action):
        def __call__(self, parser, namespace, values, option_string=None):
            if getattr(namespace, self.dest) is not None:
                parser.error(f"{option_string} given twice")
            setattr(namespace, self.dest, values)

    parser = argparse.ArgumentParser(prog="audit ledger", allow_abbrev=False, epilog=LEDGER_HELP,
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     description="Append one validated event to the findings ledger of the worktree's branch.")
    parser.add_argument("event", choices=list(EVENT_KEYS))
    parser.add_argument("--worktree", required=True, action=Once, help="the worktree whose repo remote and branch key the ledger")
    parser.add_argument("--loop", choices=LEDGER_LOOPS, action=Once)
    parser.add_argument("--phase", choices=LEDGER_PHASES, action=Once)
    parser.add_argument("--round", type=int, action=Once)
    parser.add_argument("--reviewer", dest="reviewers", action="append")
    parser.add_argument("--id", action=Once)
    parser.add_argument("--loc", action=Once, help="free text for the reader, for example file:line")
    parser.add_argument("--type", choices=LEDGER_TYPES, action=Once)
    parser.add_argument("--reason", action=Once)
    parser.add_argument("--finding", action=Once)
    parser.add_argument("--verifier", action=Once)
    parser.add_argument("--result", choices=LEDGER_RESULTS, action=Once)
    parser.add_argument("--status", choices=LEDGER_STATUSES, action=Once)
    parser.add_argument("--sha", action=Once)
    args = parser.parse_args(argv)
    expected = set(EVENT_KEYS[args.event])
    given = {key for key in VALID_VALUE if getattr(args, key, None) is not None}
    if given != expected:
        flags = lambda keys: ", ".join("--reviewer" if key == "reviewers" else f"--{key}" for key in EVENT_KEYS[args.event] if key in keys)
        parser.error(f"a {args.event} event needs exactly {flags(expected)}"
                     + (f" (missing {flags(expected - given)})" if expected - given else "")
                     + (f" (not allowed: {', '.join(sorted(given - expected))})" if given - expected else ""))
    event = {"kind": args.event, "time": _now("milliseconds")}
    event.update({key: getattr(args, key) for key in EVENT_KEYS[args.event]})
    return args.worktree, event


def _open_ledger_dir(worktree):
    """(the open audit runtime folder, the branch, the origin URL) that key the ledger of `worktree`; the caller closes the folder."""
    branch = _git_output(worktree, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        raise Refusal(f"no branch: {worktree} is not a git worktree or HEAD is detached")
    remote_url = _git_output(worktree, "remote", "get-url", "origin", no_result=(2, 128))
    if not remote_url:
        raise Refusal("no remote URL for origin")
    runtime_dir = _runtime()
    dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
    if dir_fd is None:
        raise Refusal("unsafe runtime folder: the audit folder is not owned by you with mode 0700, or is a symlink")
    return dir_fd, branch, remote_url


def _ledger(argv):
    import stat

    worktree, event = _ledger_event(argv)
    dir_fd, branch, remote_url = _open_ledger_dir(worktree)
    name = _ledger_name(remote_url, branch)
    runtime_dir = _runtime()
    try:
        try:
            lock_fd = runtime_dir.lock_file(dir_fd, name + ".lock")
        except BlockingIOError:
            raise Refusal("the ledger is locked by another call")
        try:
            data = _read_runtime_file(dir_fd, name + ".jsonl", "ledger")
            try:
                ledger = _replay(data.decode("utf-8") if data else "")
            except (LedgerError, UnicodeDecodeError) as problem:
                raise Refusal(f"the ledger holds an invalid line, nothing is written: {problem}")
            try:
                ledger.apply(event)
            except LedgerError as problem:
                raise Refusal(f"malformed event: {problem}")
            encoded = (json.dumps(event) + "\n").encode("utf-8")
            if len(encoded) > MAX_LEDGER_LINE_BYTES:
                raise Refusal(f"event too long: {len(encoded)} bytes, the limit is {MAX_LEDGER_LINE_BYTES}")
            file_fd = os.open(name + ".jsonl", os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                              0o600, dir_fd=dir_fd)
            try:
                if not stat.S_ISREG(os.fstat(file_fd).st_mode):
                    raise Refusal("unreadable ledger")
                if os.write(file_fd, encoded) != len(encoded):
                    raise OSError("short write")
            finally:
                os.close(file_fd)
        finally:
            os.close(lock_fd)
    finally:
        os.close(dir_fd)
    print(f"ok {event['kind']}")
    return 0


def cmd_ledger(argv):
    show = argv[:1] == ["show"]
    try:
        return _ledger_show(argv[1:]) if show else _ledger(argv)
    except Refusal as refusal:
        print(refusal, file=sys.stderr)
    except Unavailable as problem:
        print(problem, file=sys.stderr)
    except Exception as error:
        print(f"cannot {'read' if show else 'write'} the ledger: {error}", file=sys.stderr)
    return 2


# ---- S3 to S6 and the agent-id cross-check, from the ledger ----

def _load_ledger(dir_fd, branch, remote_url):
    """(ledger, None, None), or (None, S3 evidence, evidence of the other ledger items) when the ledger cannot be used."""
    try:
        data = _read_runtime_file(dir_fd, _ledger_name(remote_url, branch) + ".jsonl", "ledger")
    except Unavailable as problem:
        return None, str(problem), str(problem)
    if data is None:
        text = f"evidence unavailable: no ledger for {branch}"
        return None, text, text
    try:
        ledger = _replay(data.decode("utf-8"))
    except (LedgerError, UnicodeDecodeError) as problem:
        return None, f"invalid ledger: {problem}", f"evidence unavailable: ledger is invalid ({problem})"
    if not ledger.events:
        return None, "ledger has no events", "evidence unavailable: ledger has no events"
    return ledger, None, None


def _truncate_lines(lines):
    shown = lines[:10]
    if len(lines) > 10:
        shown.append(f"and {len(lines) - 10} more")
    return "\n".join(shown)


def check_s3(ledger):
    """Returns (passed, evidence)."""
    capped = {event["loop"] for _, event in ledger.round_events if event["round"] >= PHASE_CAPS[event["phase"]]}
    open_findings = [entry["event"] for entry in ledger.findings.values() if entry["status"] is None]
    blocked = [event for event in open_findings if event["loop"] not in capped]
    exempt = [event for event in open_findings if event["loop"] in capped]
    describe = lambda events: _truncate_lines([f"{event['id']} {event['loc']}" for event in events])
    if blocked:
        return False, f"{len(blocked)} findings have no status\n" + describe(blocked)
    summary = f"{len(ledger.events)} events, {len(ledger.findings)} findings"
    if exempt:
        return True, f"{summary}; stopped at cap: {len(exempt)} open findings\n" + describe(exempt)
    return True, f"{summary}, none open"


def _agents(audited):
    """agent id -> the subagent transcript, over every audited session."""
    agents = {}
    for transcripts in audited:
        for transcript in transcripts:
            match = AGENT_TRANSCRIPT.fullmatch(transcript.name)
            if match:
                agents[match.group(1)] = transcript
    return agents


def _is_sonnet(transcript):
    """Rows that Claude Code writes itself (model <synthetic>) are not model calls and do not count."""
    return _model_problem(transcript) is None


def check_s4(ledger, agents, problem):
    """Returns (passed, evidence). `agents` is None when the transcripts cannot be read, with the reason in `problem`."""
    blocking = [entry["event"] for entry in ledger.findings.values()
                if entry["event"]["loop"] == CODE_REVIEW and entry["event"]["type"] == "Blocking"]
    if not blocking:
        return True, f"no Blocking finding in the {CODE_REVIEW} loop"
    if agents is None:
        return False, problem
    failures = []
    for finding in blocking:
        mine = [verdict for verdict in ledger.verdicts if verdict["finding"] == finding["id"]]
        if not mine:
            failures.append(f"{finding['id']}: no verdict")
        elif not any(verdict["verifier"] in agents and _is_sonnet(agents[verdict["verifier"]]) for verdict in mine):
            failures.append(f"{finding['id']}: no verdict by a Sonnet subagent of an audited transcript")
    if failures:
        return False, _truncate_lines(failures)
    return True, f"{len(blocking)} Blocking findings, each with a verdict by a Sonnet subagent"


def check_s5(ledger):
    """Returns (passed, evidence)."""
    failures = [f"{loop} {phase}: round {number} is past the cap of {PHASE_CAPS[phase]}"
                for (loop, phase), number in ledger.rounds.items() if number > PHASE_CAPS[phase]]
    if failures:
        return False, _truncate_lines(failures)
    return True, f"{len(ledger.round_events)} rounds in {len(ledger.rounds)} loop phases, none past a cap"


def check_s6(worktree, ledger):
    """Returns (passed, evidence)."""
    final = next((position for position, event in ledger.round_events if event["loop"] == CODE_REVIEW and event["phase"] == "final"), None)
    if final is None:
        return True, "no section 6 final round"
    before = [event for position, event in ledger.commits if position < final]
    if not before:
        return False, "no phase-commit before the first final round of the section 6 loop"
    sha = before[-1]["sha"]
    try:
        known = _git_output(worktree, "rev-parse", "--verify", "-q", f"{sha}^{{commit}}")
    except RuntimeError as problem:
        raise Unavailable(str(problem))
    if not known:
        return False, f"unknown commit {sha[:7]}"
    result = _git(worktree, "merge-base", "--is-ancestor", sha, "HEAD")
    if result.returncode == 0:
        return True, f"phase-commit {sha[:7]} is an ancestor of HEAD"
    if result.returncode == 1:
        return False, f"phase-commit {sha[:7]} is not an ancestor of HEAD"
    raise Unavailable(f"git merge-base exited with status {result.returncode}: {result.stderr.strip()}")


def check_xc(ledger, agents, problem):
    """Returns (passed, evidence): every reviewer and verifier is a Sonnet subagent that started after the previous round of its loop."""
    if agents is None:
        return False, problem
    by_loop = {}
    for _, event in ledger.round_events:
        by_loop.setdefault(event["loop"], []).append(event)

    def lower_bound(round_event):
        events = by_loop[round_event["loop"]]
        index = events.index(round_event)
        return _instant(events[index - 1]["time"], "the ledger") if index else None

    checks = []
    for events in by_loop.values():
        for event in events:
            for agent in event["reviewers"]:
                checks.append((f"reviewer {agent} of {event['loop']} {event['phase']} round {event['round']}", agent, lower_bound(event)))
    for verdict in ledger.verdicts:
        finding = ledger.findings[verdict["finding"]]["event"]
        round_event = next(event for event in by_loop[finding["loop"]]
                           if event["phase"] == finding["phase"] and event["round"] == finding["round"])
        checks.append((f"verifier {verdict['verifier']} of {finding['id']}", verdict["verifier"], lower_bound(round_event)))
    failures = []
    for label, agent, low in checks:
        transcript = agents.get(agent)
        if transcript is None:
            failures.append(f"{label}: not a subagent of an audited transcript")
        elif not _is_sonnet(transcript):
            failures.append(f"{label}: not a Sonnet subagent")
        elif low is not None:
            if transcript.start is None:
                failures.append(f"{label}: evidence unavailable: no readable start time")
            elif not transcript.start > low:
                failures.append(f"{label}: started before the previous round of its loop")
    if failures:
        return False, _truncate_lines(failures)
    return True, f"{len(checks)} reviewers and verifiers checked"


def _s_item(name, passed, evidence, note=""):
    return {"id": name, "kind": "S", "result": "pass" if passed else "fail", "evidence": _cut(evidence) + note}


def _check_item(name, check, *args, note=""):
    try:
        passed, evidence = check(*args)
    except Unavailable as problem:
        passed, evidence = False, str(problem)
    return _s_item(name, passed, evidence, note)


def _ledger_items(worktree, dir_fd, branch, remote_url, audited, problem):
    """S3 to S6 and XC. `audited` is None when the transcripts cannot be read, with the reason in `problem`."""
    ledger, s3_evidence, other_evidence = _load_ledger(dir_fd, branch, remote_url)
    if ledger is None:
        return [_s_item("S3", False, s3_evidence)] + [_s_item(name, False, other_evidence) for name in ("S4", "S5", "S6", "XC")]
    agents = None if audited is None else _agents(audited)
    text = str(problem)
    return [_check_item("S3", check_s3, ledger), _check_item("S4", check_s4, ledger, agents, text), _check_item("S5", check_s5, ledger),
            _check_item("S6", check_s6, worktree, ledger), _check_item("XC", check_xc, ledger, agents, text)]


# ---- S7 and S9: models and safety, from the transcripts ----

def _model_problem(transcript):
    """None when every assistant row of the transcript (rows with the model <synthetic> aside) names a Sonnet model, else why not.
    A model that is not Sonnet wins over a missing one."""
    models = transcript.models - {SYNTHETIC_MODEL}
    other = sorted(model for model in models if model is not None and "sonnet" not in model.lower())
    if other:
        return "ran on " + ", ".join(repr(model[:MODEL_LIMIT]) for model in other)
    if not models:
        return "evidence unavailable: no assistant row with a model"
    if None in models:
        return "evidence unavailable: an assistant row without a string message.model"
    return None


def check_s7(audited, problem):
    """Returns (passed, evidence). `audited` is None when the transcripts cannot be read, with the reason in `problem`."""
    if audited is None:
        return False, problem
    failures, subagents, workers = [], 0, 0
    for transcripts in audited:
        is_worker = any(all(marker in text for marker in WORKER_MARKERS) for text in transcripts[0].prompts)
        workers += is_worker
        subagents += len(transcripts) - 1
        for transcript in (transcripts if is_worker else transcripts[1:]):
            reason = _model_problem(transcript)
            if reason:
                failures.append(f"{transcript.name}: {reason}")
    if failures:
        return False, _truncate_lines(failures)
    return True, f"{subagents} subagents and {workers} worker sessions on Sonnet models, {len(audited) - workers} main sessions exempt"


def _recursive_rm(arguments):
    for word in arguments:
        if word == "--":
            return False
        if RM_RECURSIVE_OPTION.fullmatch(word) or (word.startswith("--r") and "--recursive".startswith(word)):
            return True
    return False


def _few_workers(value):
    return re.fullmatch(r"[0-9]+", value) is not None and value.lstrip("0") in ("", "1", "2")


def _subcommand(words):
    return next((word for word in words if not word.startswith(("-", "+"))), None)


def _worker_problems(name, words, index):
    problems = []
    if name == "vitest":
        for word in words:
            variable = VITEST_VARIABLE.fullmatch(word)
            if variable and not _few_workers(variable.group(2)):
                problems.append(f"{name} {variable.group(1)} {variable.group(2)[:VALUE_LIMIT]!r}")
    after = words[index + 1:]
    for position, word in enumerate(after):
        candidate = word[1:] if name == "go" and word.startswith("--") else word  # Go's flag package takes one or two dashes
        for flag in RUNNER_FLAGS[name]:
            if candidate == flag:
                value = after[position + 1] if position + 1 < len(after) else None
            elif candidate.startswith(flag + "="):
                value = candidate[len(flag) + 1:]
            elif name != "go" and len(flag) == 2 and flag[1] != "-" and candidate.startswith(flag):
                value = candidate[len(flag):]  # -n4
            else:
                continue
            if value is None:
                problems.append(f"{name} {flag} with no value")
            elif not _few_workers(value):
                problems.append(f"{name} {flag} {value[:VALUE_LIMIT]!r}")
            break
    return problems


def _runner_problems(words):
    for index, word in enumerate(words):
        name = os.path.basename(word)
        if name in RUNNER_FLAGS and (name not in SUBCOMMAND_RUNNERS or _subcommand(words[index + 1:]) == "test"):
            return _worker_problems(name, words, index)
    return []


def _nested_problems(text, depth):
    if depth + 1 > MAX_SHELL_DEPTH:
        return [f"evidence unavailable: shell commands nested deeper than {MAX_SHELL_DEPTH}"]
    return _command_problems(text, depth + 1)


def _segment_problems(words, depth):
    commands = _command_words(words)
    if commands and os.path.basename(commands[0]) in NAMING_ONLY_COMMANDS:
        return []
    found = []
    for index, word in enumerate(words):
        name = os.path.basename(word)
        if name not in ARGUMENT_COMMANDS:
            continue
        arguments = words[index + 1:]
        if name == "rm" and _recursive_rm(arguments):
            found.append("recursive rm")
        elif name == "docker" and "prune" in arguments:
            found.append("docker prune")
        elif name == "eval" and arguments:
            found += _nested_problems(" ".join(arguments), depth)
        elif name in SHELLS:
            option = next((position for position, argument in enumerate(arguments) if SHELL_COMMAND_OPTION.fullmatch(argument)), None)
            if option is not None and option + 1 < len(arguments):
                found += _nested_problems(arguments[option + 1], depth)
    return found + _runner_problems(words)


def _command_problems(command, depth=0):
    """What S9 finds in one command text: a list of kinds, those that start with "evidence unavailable" are not violations."""
    command = command.replace("\\\n", "")  # bash joins a line that ends in a backslash with the next one; the splitter would end the segment
    try:
        items = split_command(command)
    except ValueError:
        return ["evidence unavailable: cannot split the command"] if UNSPLITTABLE_TRIGGER.search(command) else []
    return [kind for item in items if isinstance(item, list) for kind in _segment_problems(item, depth)]


def check_s9(audited, problem):
    """Returns (passed, evidence). `audited` is None when the transcripts cannot be read, with the reason in `problem`."""
    if audited is None:
        return False, problem
    lines, checked = [], 0
    for transcripts in audited:
        for transcript in transcripts:
            for call in transcript.calls:
                if call["tool"] == "Bash":
                    checked += 1
                    lines += [f"{transcript.name}: row {call['index'] + 1}: {kind}" for kind in dict.fromkeys(_command_problems(call["command"]))]
    if lines:
        return False, _truncate_lines(lines)
    return True, f"{checked} Bash commands checked"


# ---- record ----

class Refusal(Exception):
    """`record` writes nothing and exits 2."""


def _load_llm(path, names=L_ITEMS):
    try:
        with open(path, "rb") as handle:
            data = json.loads(handle.read().decode("utf-8"))
    except (OSError, ValueError) as error:
        raise Refusal(f"malformed L input: cannot read {path}: {error}")
    if not isinstance(data, dict) or set(data) != set(names):
        raise Refusal("malformed L input: need an object with exactly the keys " + (f"{names[0]} to {names[-1]}" if len(names) > 1 else names[0]))
    items = []
    for name in names:
        verdict = data[name]
        if not isinstance(verdict, dict) or set(verdict) != {"result", "evidence"}:
            raise Refusal(f"malformed L input: {name} needs exactly result and evidence")
        evidence = verdict["evidence"]
        if verdict["result"] not in ("pass", "fail") or not isinstance(evidence, str) or not 1 <= len(evidence) <= L_EVIDENCE_LIMIT:
            raise Refusal(f"malformed L input: {name} needs result pass or fail and evidence of 1 to {L_EVIDENCE_LIMIT} characters")
        items.append({"id": name, "kind": "L", "result": verdict["result"], "evidence": evidence})
    return items


def _record_arguments(argv):
    values = {}
    for index in range(0, len(argv), 2):
        flag = argv[index]
        if flag not in ("--worktree", "--llm") or flag in values or index + 1 >= len(argv):
            raise Refusal(USAGE)
        values[flag] = argv[index + 1]
    if set(values) != {"--worktree", "--llm"}:
        raise Refusal(USAGE)
    return values["--worktree"], values["--llm"]


def _now(timespec="seconds"):
    from datetime import datetime, timezone  # imported here: the hook's common path never needs the time

    return datetime.now(timezone.utc).isoformat(timespec=timespec)


def _transcript_items(worktree, dir_fd):
    """(the S1 and S2 items, the audited transcripts, the reason they cannot be read). Evidence that cannot be read fails both items
    with "evidence unavailable"; the transcripts are then None."""
    try:
        audited = _audited_transcripts(worktree, dir_fd)
    except Unavailable as problem:
        return [_s_item(name, False, str(problem)) for name in ("S1", "S2")], None, problem
    note = _versions_note(audited)
    items = [_check_item(name, check, worktree, audited, note=note) for name, check in (("S1", check_s1), ("S2", check_s2))]
    return items, audited, None


def _run_items(worktree, dir_fd, branch, remote_url):
    """(the items S1 to S9 and XC in record order, the audited transcripts, the reason they cannot be read).
    The transcripts are None when they cannot be read."""
    items, audited, problem = _transcript_items(worktree, dir_fd)
    items += _ledger_items(worktree, dir_fd, branch, remote_url, audited, problem)
    items.append(_check_item("S7", check_s7, audited, str(problem)))
    passed, evidence = check_s8(worktree)
    items.append({"id": "S8", "kind": "S", "result": "pass" if passed else "fail", "evidence": evidence})
    items.append(_check_item("S9", check_s9, audited, str(problem)))
    return items, audited, problem


def _record(argv):
    worktree, llm_path = _record_arguments(argv)
    l_items = _load_llm(llm_path)
    branch = _git_output(worktree, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        raise Refusal(f"no branch to record: {worktree} is not a git worktree or HEAD is detached")
    tip = _git_output(worktree, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}^{{commit}}")
    if not tip:
        raise Refusal(f"push first: origin/{branch} does not exist")
    if _git_output(worktree, "rev-parse", "HEAD") != tip:
        raise Refusal(f"push first: HEAD differs from origin/{branch}")
    remote_url = _git_output(worktree, "remote", "get-url", "origin", no_result=(2, 128))
    if not remote_url:
        raise Refusal("no remote URL for origin")
    runtime_dir = _runtime()
    dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
    if dir_fd is None:
        raise Refusal("unsafe runtime folder")
    try:
        items = _run_items(worktree, dir_fd, branch, remote_url)[0] + l_items
        result = "pass" if all(item["result"] == "pass" for item in items) else "fail"
        text = json.dumps({
            "sha": tip, "remote_url": remote_url, "branch": branch,
            "time": _now(), "items": items, "result": result,
        })
        if len(text) > runtime_dir.MAX_READ_BYTES:
            raise Refusal("record too large")
        runtime_dir.write_atomic(dir_fd, f"{tip}.json", text)
    finally:
        os.close(dir_fd)
    for item in items:
        print(item["id"], item["result"])
    print("result", result)
    return 0 if result == "pass" else 1


def _pre_dispatch_arguments(argv):
    """(worktree, map issue, llm path) of `record --pre-dispatch`: the bare flag once, and each of the three flags once, in any order."""
    rest = [word for word in argv if word != "--pre-dispatch"]
    if len(argv) - len(rest) != 1 or len(rest) != 6:
        raise Refusal(USAGE)
    values = {}
    for index in range(0, len(rest), 2):
        flag = rest[index]
        if flag not in ("--worktree", "--map", "--llm") or flag in values:
            raise Refusal(USAGE)
        values[flag] = rest[index + 1]
    if not MAP_ISSUE.fullmatch(values["--map"]):
        raise Refusal("bad --map: need an issue number (1 to 9 digits, no leading zero)")
    return values["--worktree"], int(values["--map"]), values["--llm"]


def _plan_review_view(ledger):
    """A new Ledger with the round and finding events of the pre-dispatch loops and the status events of those findings."""
    view, findings = Ledger(), set()
    for event in ledger.events:
        if event["kind"] in ("round", "finding") and event["loop"] in PRE_DISPATCH_LOOPS:
            if event["kind"] == "finding":
                findings.add(event["id"])
            view.apply(event)
        elif event["kind"] == "status" and event["finding"] in findings:
            view.apply(event)
    return view


def check_s3_pre_dispatch(view):
    """S3 for the plan-review view: both loops must have a round event. Returns (passed, evidence)."""
    missing = [loop for loop in PRE_DISPATCH_LOOPS if not any(event["loop"] == loop for _, event in view.round_events)]
    if missing:
        return False, "evidence unavailable: no round event for " + ", ".join(missing)
    return check_s3(view)


def _pre_dispatch_items(worktree, dir_fd, branch, remote_url):
    """S3, S5, S7 and XC in record order."""
    try:
        audited, problem = _audited_transcripts(worktree, dir_fd), None
    except Unavailable as unavailable:
        audited, problem = None, unavailable
    text = str(problem)
    ledger, s3_evidence, other_evidence = _load_ledger(dir_fd, branch, remote_url)
    s7 = _check_item("S7", check_s7, audited, text)
    if ledger is None:
        return [_s_item("S3", False, s3_evidence), _s_item("S5", False, other_evidence), s7, _s_item("XC", False, other_evidence)]
    view = _plan_review_view(ledger)
    agents = None if audited is None else _agents(audited)
    return [_check_item("S3", check_s3_pre_dispatch, view), _check_item("S5", check_s5, view), s7, _check_item("XC", check_xc, view, agents, text)]


def _pre_dispatch(argv):
    worktree, map_issue, llm_path = _pre_dispatch_arguments(argv)
    l_items = _load_llm(llm_path, ("L1",))
    runtime_dir = _runtime()
    session_id = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not runtime_dir.valid_session_id(session_id):
        raise Refusal("no session id: CLAUDE_CODE_SESSION_ID is missing or invalid")
    branch = _git_output(worktree, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        raise Refusal(f"no branch to record: {worktree} is not a git worktree or HEAD is detached")
    remote_url = _git_output(worktree, "remote", "get-url", "origin", no_result=(2, 128))
    if not remote_url:
        raise Refusal("no remote URL for origin")
    dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
    if dir_fd is None:
        raise Refusal("unsafe runtime folder")
    try:
        items = _pre_dispatch_items(worktree, dir_fd, branch, remote_url) + l_items
        result = "pass" if all(item["result"] == "pass" for item in items) else "fail"
        text = json.dumps({
            "session_id": session_id, "map": map_issue, "remote_url": remote_url, "branch": branch,
            "time": _now(), "items": items, "result": result,
        })
        if len(text) > runtime_dir.MAX_READ_BYTES:
            raise Refusal("record too large")
        runtime_dir.write_atomic(dir_fd, PRE_DISPATCH_NAME % session_id, text)
    finally:
        os.close(dir_fd)
    for item in items:
        print(item["id"], item["result"])
    print("result", result)
    return 0 if result == "pass" else 1


def cmd_record(argv):
    try:
        return _pre_dispatch(argv) if "--pre-dispatch" in argv else _record(argv)
    except Refusal as refusal:
        print(refusal, file=sys.stderr)
    except Exception as error:
        print(f"cannot record: {error}", file=sys.stderr)
    return 2


# ---- check: the S results and the digest for the auditor ----

LEDGER_BUDGET, COMMITS_BUDGET, SESSIONS_BUDGET = 16384, 4096, 30720
DIGEST_LIMIT = LEDGER_BUDGET + COMMITS_BUDGET + SESSIONS_BUDGET  # 50 KB
PROMPT_LIMIT, COMMAND_LIMIT, FIELD_LIMIT, PATH_LIMIT, COMMIT_LIMIT = 500, 200, 100, 200, 200  # in characters; the budgets are in bytes
OMITTED_RESERVE = len("[99999999 more lines omitted]") + 1  # room for the widest marker line that _fit appends, and its newline


def _utf8(text):
    """The bytes of `text`; a lone surrogate in transcript text becomes `?`, so that no text stops the digest."""
    return text.encode("utf-8", "replace")


def _fit(lines, budget):
    """The lines, cut at a whole line to at most `budget` bytes once joined with newlines; the cut ends with a marker line."""
    costs = [len(_utf8(line)) + 1 for line in lines]
    if sum(costs) - 1 <= budget:
        return lines
    kept, total = 0, 0
    for cost in costs:
        if total + cost > budget - OMITTED_RESERVE:
            break
        total += cost
        kept += 1
    return lines[:kept] + [f"[{len(lines) - kept} more lines omitted]"]


def _flat(text, limit):
    return _cut(" ".join(text.split()), limit)


def _utc(moment):
    from datetime import timezone  # imported here: the hook's common path never reads times

    return "?" if moment is None else moment.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _ledger_lines(dir_fd, branch, remote_url):
    """(the lines `ledger` and one compact JSON line per event, the event count), or ([the `ledger unavailable` line], None)."""
    ledger, why, _ = _load_ledger(dir_fd, branch, remote_url)
    if ledger is None:
        return [f"ledger unavailable: {why}"], None
    return ["ledger"] + [json.dumps(event, ensure_ascii=False, separators=(",", ":")) for event in ledger.events], len(ledger.events)


def _ledger_show(argv):
    """`audit ledger show --worktree <path>`: print every event of the ledger and write nothing; exit 2 when the ledger cannot be used."""
    if len(argv) != 2 or argv[0] != "--worktree":
        raise Refusal(USAGE)
    dir_fd, branch, remote_url = _open_ledger_dir(argv[1])
    try:
        lines, count = _ledger_lines(dir_fd, branch, remote_url)
    finally:
        os.close(dir_fd)
    print("\n".join(lines))
    return 0 if count is not None else 2


def _ledger_section(worktree, dir_fd, branch, remote_url):
    """One pointer line with the event count and the command that reads the events, or the `ledger unavailable` line."""
    lines, count = _ledger_lines(dir_fd, branch, remote_url)
    if count is None:
        return lines
    return [f"ledger: {count} events; read them with: python3 -I ~/.claude/hooks/workflow-audit/audit ledger show --worktree {worktree}"]


def _commit_lines(worktree):
    base, why = _commit_base(worktree)
    if base is None:
        return [f"commits unavailable: {why}"]
    log = _git(worktree, "log", "--format=%h %s", f"{base}..HEAD")
    stat = _git(worktree, "diff", "--shortstat", base, "HEAD")
    if log.returncode != 0 or stat.returncode != 0:
        return [f"commits unavailable: git failed: {(log.stderr or stat.stderr).strip()}"]
    return [f"commits since {base[:7]}"] + [_flat(line, COMMIT_LIMIT) for line in log.stdout.splitlines()] + [stat.stdout.strip() or "no diff"]


def _session_lines(audited, problem):
    if audited is None:
        return [f"digest unavailable: {problem}"]
    lines = []
    for transcripts in audited:
        main, subagents = transcripts[0], transcripts[1:]
        lines.append(f"session {main.name}")
        prompt = next((text for text in main.prompts if not text.lstrip().startswith("<task-notification>")), None)
        lines.append("  prompt: " + ("(none)" if prompt is None else _flat(prompt, PROMPT_LIMIT)))
        edits = [call for call in main.calls if call["tool"] in EDIT_TOOLS]
        lines.append(f"  edits: {len(edits)}")
        lines += ["  edited: " + _flat(path, PATH_LIMIT) for path in dict.fromkeys(call["path"] for call in edits)]
        lines += [f"  bash {_utc(call['time'])} {_flat(call['command'], COMMAND_LIMIT)}" for call in main.calls if call["tool"] == "Bash"]
        for tool, fields in main.launches:
            lines.append(f"  {tool.lower()}: " + " | ".join("?" if field is None else _flat(field, FIELD_LIMIT) for field in fields))
        for sub in subagents:
            models = sorted("?" if model is None else _flat(model, MODEL_LIMIT) for model in sub.models)
            lines.append(f"  subagent {sub.name} first row {_utc(sub.start)} models: {', '.join(models)}")
    return lines


def _digest(worktree, dir_fd, branch, remote_url, audited, problem):
    """The text for the auditor: the ledger pointer, the commits and one block per audited session, at most DIGEST_LIMIT bytes."""
    # The sections are joined with two newlines, so the first two budgets give up one byte each to keep the total at DIGEST_LIMIT.
    sections = (_fit(_ledger_section(worktree, dir_fd, branch, remote_url), LEDGER_BUDGET - 1),
                _fit(_commit_lines(worktree), COMMITS_BUDGET - 1),
                _fit(_session_lines(audited, problem), SESSIONS_BUDGET))
    text = "\n".join("\n".join(section) for section in sections)
    data = _utf8(text)
    if len(data) > DIGEST_LIMIT:  # a last guard; the section budgets keep the digest under the limit
        marker = "\n[digest cut]"
        text = data[: DIGEST_LIMIT - len(marker)].decode("utf-8", "ignore") + marker
    return text


def _check(argv):
    if len(argv) != 2 or argv[0] != "--worktree":
        raise Refusal(USAGE)
    worktree = argv[1]
    branch = _git_output(worktree, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        raise Refusal(f"no branch to check: {worktree} is not a git worktree or HEAD is detached")
    remote_url = _git_output(worktree, "remote", "get-url", "origin", no_result=(2, 128))
    if not remote_url:
        raise Refusal("no remote URL for origin")
    runtime_dir = _runtime()
    dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
    if dir_fd is None:
        raise Refusal("unsafe runtime folder")
    try:
        items, audited, problem = _run_items(worktree, dir_fd, branch, remote_url)
        digest = _digest(worktree, dir_fd, branch, remote_url, audited, problem)
    finally:
        os.close(dir_fd)
    lines = []
    for item in items:
        lines.append(f"{item['id']} {item['result']}")
        lines += ["  " + line for line in item["evidence"].splitlines()]
    lines.append("result " + ("pass" if all(item["result"] == "pass" for item in items) else "fail"))
    lines.append(f"digest {len(_utf8(digest))} bytes")
    lines.append("--- digest ---")
    sys.stdout.buffer.write(_utf8("\n".join(lines) + "\n" + digest + "\n"))
    sys.stdout.flush()
    return 0


def cmd_check(argv):
    try:
        return _check(argv)
    except Refusal as refusal:
        print(refusal, file=sys.stderr)
    except Exception as error:
        print(f"cannot check: {error}", file=sys.stderr)
    return 2


# ---- gate: PreToolUse ----

def split_command(command):
    """The command as a list of items: a list of words for each segment, and the separator token between segments as a string.
    Raises ValueError for an unbalanced quote."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars="".join(sorted(SEPARATOR_CHARS)))
    lexer.whitespace_split = True
    lexer.whitespace = " \t\r"  # a newline is a separator, not whitespace
    lexer.commenters = ""  # shlex would drop the text after a `#`, even inside a word
    items, words = [], []
    for token in lexer:
        if token and set(token) <= SEPARATOR_CHARS:  # shlex joins adjacent separators into one token
            if words:
                items.append(words)
                words = []
            items.append(token)
        else:
            words.append(token)
    if words:
        items.append(words)
    return items


def _operator(separator):
    """A separator token without its parentheses and newlines: shlex joins adjacent separators, so `&\n` and `|(` are one token."""
    return "".join(char for char in separator if char not in "()\n")


def _command_words(segment):
    index = 0
    while index < len(segment) and (ENV_ASSIGNMENT.match(segment[index]) or segment[index] in COMMAND_PREFIX_WORDS):
        index += 1
    return segment[index:]


def _is_pr_create(segment):
    words = _command_words(segment)
    return len(words) >= 3 and os.path.basename(words[0]) == "gh" and words[1:3] == ["pr", "create"]


def _is_worker_start(segment):
    words = _command_words(segment)
    return len(words) >= 3 and os.path.basename(words[0]) in ORCA_COMMANDS and words[1:3] == ["orchestration", "worker-start"]


def _is_help(segment):
    """A gated command whose only argument is `--help` or `-h`: it prints its help text and runs nothing."""
    return _command_words(segment)[3:] in (["--help"], ["-h"])


def _is_gated_pr_create(segment):
    """A `gh pr create` that needs a passing record: one that is not a help-only command."""
    return _is_pr_create(segment) and not _is_help(segment)


def _is_dispatch(segment):
    """A `worker-start` that needs a pre-dispatch record: one that is not a help-only command and has no `--retry-of` (the
    flag at any word position), which can only restart a Task that was dispatched before."""
    return _is_worker_start(segment) and not _is_help(segment) and not any(
        word == "--retry-of" or word.startswith("--retry-of=") for word in _command_words(segment)[3:])


REDIRECTION = re.compile(r"(?:\{\w+\}|\d+|&)?[<>]+[|&]?(.*)", re.DOTALL)
GIT_VALUE_OPTIONS = frozenset(("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env", "--attr-source"))
DASHED_GIT = {"git-branch": "branch", "git-push": "push", "git-worktree": "worktree"}  # the dashed programs of git-core
CLEANUP_INTERPRETERS = frozenset(("python", "python3"))
# The count patterns, over the normalised text. A redirection token is `2>`, `>f`, `{fd}>f`; a bare one is followed by its target word
# (never an option word, and never another redirection, so that a run of them cannot backtrack in many ways).
REDIRECTION_START = r"(?:\{\w+\}|\d+|&)?[<>]"
REDIRECTION_TEXT = rf"(?>(?:\{{\w+\}}|\d+|&)?[<>]+[|&]?(?:\S+|(?: (?!-|{REDIRECTION_START})\S+)?))"
# A value option takes a value that is no option and no redirection (bash reads `-C 2> f` as the flag and a redirection). Every token has one
# parse, and the runs are atomic, so a failing match never tries the others: a long run of option words cannot take exponential time.
GIT_OPTION_TEXT = rf"(?>(?:-C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env|--attr-source) (?!-|{REDIRECTION_START})\S+|-\S+)"
BETWEEN_GIT_WORDS = rf"(?>(?: (?:{GIT_OPTION_TEXT}|{REDIRECTION_TEXT}))*)"
BETWEEN_WORDS = rf"(?>(?: {REDIRECTION_TEXT})*)"


def _git_pattern(subcommand):
    """Each `git` word that starts the form (a lookahead, so an option value never hides a `git` inside it): the program, a dashed
    program or global options and redirections, then the subcommand."""
    return re.compile(rf"(?<![\w.-])git(?=(?:-{subcommand}|{BETWEEN_GIT_WORDS} {subcommand})(?![\w.-]))")


def _significant(words):
    """The words as (index, word) without the redirections: a redirection word, and the next word of a bare one unless that is an option word."""
    kept, index = [], 0
    while index < len(words):
        match = REDIRECTION.fullmatch(words[index])
        if not match:
            kept.append((index, words[index]))
            index += 1
            continue
        index += 1
        if not match.group(1) and index < len(words) and not words[index].startswith("-"):
            index += 1
    return kept


def _git_command(segment):
    """The significant words of a `git` segment from the subcommand on, or None when the segment is no git command. A dashed program
    (`git-branch`) is its subcommand with no global options."""
    significant = _significant(_command_words(segment))
    if not significant:
        return None
    program = os.path.basename(significant[0][1])
    if program in DASHED_GIT:
        return [(significant[0][0], DASHED_GIT[program])] + significant[1:]
    if program != "git":
        return None
    position = 1
    while position < len(significant) and significant[position][1].startswith("-"):
        position += 2 if significant[position][1] in GIT_VALUE_OPTIONS else 1
    return significant[position:]


def _git_subcommand(segment, *names):
    rest = _git_command(segment)
    if rest is None or [word for _, word in rest[:len(names)]] != list(names):
        return None
    return rest


def _orca_worktree_rm(segment):
    significant = _significant(_command_words(segment))
    if len(significant) >= 3 and os.path.basename(significant[0][1]) in ORCA_COMMANDS and [word for _, word in significant[1:3]] == ["worktree", "rm"]:
        return significant
    return None


def _cleanup_arguments(segment):
    """The significant words after the cleanup word of a `cleanup` segment, or None when the segment is no cleanup command."""
    significant = _significant(_command_words(segment))
    if not significant:
        return None
    program = os.path.basename(significant[0][1])
    if program == "cleanup":
        return significant[1:]
    if program in CLEANUP_INTERPRETERS:
        for position, (_, word) in enumerate(significant[1:], 1):
            if not word.startswith("-"):
                return significant[position + 1:] if os.path.basename(word) == "cleanup" else None
    return None


def _only_help(rest):
    return [word for _, word in rest] in (["--help"], ["-h"])


def _long_option(word, name):
    """A long option that git can read as `name`: an abbreviation of 3 characters or more, the dashes included. An ambiguous one matches too."""
    option = word.split("=", 1)[0]
    return len(option) >= 3 and name.startswith(option)


def _is_force_delete(arguments):
    delete = force = False
    for word in arguments:
        if word == "--":
            break
        if word.startswith("--"):
            delete = delete or _long_option(word, "--delete")
            force = force or _long_option(word, "--force")
        elif word.startswith("-") and len(word) > 1:
            if "D" in word:
                return True
            delete = delete or "d" in word
            force = force or "f" in word
    return delete and force


def _is_push_delete(arguments):
    options = True
    for word in arguments:
        if word == "--":
            options = False
        elif word.startswith((":", "+:")):
            return True
        elif options and word.startswith("--"):
            if any(_long_option(word, name) for name in ("--delete", "--prune", "--mirror")):
                return True
        elif options and word.startswith("-") and "d" in word:
            return True
    return False


def _head_of(segment, rest, position):
    """The command words of the segment from its first word through the word at `position` of `rest`: the head of the form."""
    return _command_words(segment)[:rest[position][0] + 1]


def _git_head(*names):
    def head(segment):
        rest = _git_subcommand(segment, *names)
        return None if rest is None else _head_of(segment, rest, len(names) - 1)
    return head


def _orca_rm_head(segment):
    significant = _orca_worktree_rm(segment)
    return None if significant is None else _head_of(segment, significant, 2)


def _has_head(head):
    return lambda segment: head(segment) is not None


def _is_flagged_cleanup(segment):
    arguments = _cleanup_arguments(segment)
    return arguments is not None and "--skip-ownership" in [word for _, word in arguments]


def _denies_orca_rm(segment):
    significant = _orca_worktree_rm(segment)
    return significant is not None and not _only_help(significant[3:])


def _denies_worktree_remove(segment):
    rest = _git_subcommand(segment, "worktree", "remove")
    return rest is not None and not _only_help(rest[2:])


def _denies_force_delete(segment):
    rest = _git_subcommand(segment, "branch")
    return rest is not None and _is_force_delete([word for _, word in rest[1:]])


def _denies_push_delete(segment):
    rest = _git_subcommand(segment, "push")
    return rest is not None and _is_push_delete([word for _, word in rest[1:]])


# The gated forms: the one place that holds their texts, read by the count rule, the unparsable-command path and the non-JSON hook-input path.
# raw_text is counted where nothing can be parsed, so it is inside count_text and has no quote character or whitespace run.
# pattern and raw_pattern (None: the literal texts) are the regular expressions over the normalised text; head is the head words of a segment of the
# form (None when the segment is no such form) that the per-segment count credits; denied and deny_reason are the deny check of the new forms,
# and pointer is the text that their reasons append.
GatedForm = namedtuple("GatedForm", ("segment", "count_text", "raw_text", "unparsable_reason", "pattern", "raw_pattern", "head", "denied",
                                     "deny_reason", "pointer"), defaults=(None, None, None, None, "", ""))
PR_FORM = GatedForm(_is_pr_create, "gh pr create", "gh pr create", "no branch to check: the command cannot be parsed")
DISPATCH_FORM = GatedForm(_is_worker_start, "orchestration worker-start", "worker-start", "no pre-dispatch record: the command cannot be parsed")
CLEANUP_POINTER = f", or use {CLEANUP_COMMAND}"


def _cleanup_form(segment, count_text, pattern, head, denied, deny_reason):
    unparsable = f"unchecked command form: the command cannot be parsed; run {count_text} as a plain command{CLEANUP_POINTER}"
    return GatedForm(segment, count_text, count_text, unparsable, pattern, pattern, head, denied, deny_reason, CLEANUP_POINTER)


GIT_BRANCH_PATTERN, GIT_PUSH_PATTERN = _git_pattern("branch"), _git_pattern("push")
BRANCH_FORM = _cleanup_form(
    _has_head(_git_head("branch")), "git branch", GIT_BRANCH_PATTERN, _git_head("branch"), _denies_force_delete,
    f"force delete of a branch is denied: run {CLEANUP_COMMAND} <worktree path> after the merge. For a branch with no worktree, "
    "the user runs `! git branch -D <branch>`")
PUSH_FORM = _cleanup_form(
    _has_head(_git_head("push")), "git push", GIT_PUSH_PATTERN, _git_head("push"), _denies_push_delete,
    f"deleting a remote ref is denied: run {CLEANUP_COMMAND} <worktree path> after the merge, it deletes the remote branch after its checks")
WORKTREE_REMOVE_FORM = _cleanup_form(
    _has_head(_git_head("worktree", "remove")), "worktree remove", re.compile(rf"(?<![\w.])worktree{BETWEEN_WORDS} remove(?![\w.-])"),
    _git_head("worktree", "remove"), _denies_worktree_remove, f"git worktree remove is denied: run {CLEANUP_COMMAND} <worktree path> instead")
WORKTREE_RM_FORM = _cleanup_form(
    _has_head(_orca_rm_head), "worktree rm", re.compile(rf"(?<![\w.])worktree{BETWEEN_WORDS} rm(?![\w.-])"), _orca_rm_head, _denies_orca_rm,
    f"orca worktree rm is denied: run {CLEANUP_COMMAND} <worktree path> instead")
SKIP_OWNERSHIP_FORM = _cleanup_form(
    _is_flagged_cleanup, "--skip-ownership", re.compile(re.escape("--skip-ownership")), None, _is_flagged_cleanup,
    f"--skip-ownership is denied: only the user runs `! {CLEANUP_COMMAND} --skip-ownership <worktree path>`, for a worktree that the session "
    "cannot prove it owns")
# The PR reason wins when a command has an unchecked form of both; the new forms follow.
GATED_FORMS = (PR_FORM, DISPATCH_FORM, BRANCH_FORM, PUSH_FORM, WORKTREE_REMOVE_FORM, WORKTREE_RM_FORM, SKIP_OWNERSHIP_FORM)


def _raw_match(text, form):
    """Whether the gated text of `form` is in a text that cannot be parsed."""
    if form.raw_pattern is not None:
        return form.raw_pattern.search(_normalise(text)) is not None
    return bool(_occurrences(text, form.raw_text))


def _head_option(arguments):
    """The last --head/-H value, or None when absent."""
    head = None
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word in ("--head", "-H"):
            head = arguments[index + 1] if index + 1 < len(arguments) else ""
            index += 1
        elif word.startswith("--head="):
            head = word[len("--head="):]
        elif word.startswith("-H") and not word.startswith("--"):
            head = word[2:].removeprefix("=")
        index += 1
    return head


def _after_cd(cwd, segment):
    """The working directory after a `cd` segment; None when it cannot be resolved."""
    arguments = segment[1:]
    if cwd is None or len(arguments) != 1 or arguments[0].startswith("-") or UNRESOLVABLE_PATH.search(arguments[0]):
        return None
    return os.path.normpath(os.path.join(cwd, os.path.expanduser(arguments[0])))


def _read_record(runtime_dir, dir_fd, name):
    """The parsed record in `name`, None when it does not exist. Raises when it cannot be read or is not valid."""
    text = runtime_dir.read_file(dir_fd, name)
    if text is None:
        return None
    record = json.loads(text)
    if (not isinstance(record, dict) or record.get("sha") != name[:-len(".json")] or record.get("result") not in ("pass", "fail")
            or not isinstance(record.get("remote_url"), str) or not isinstance(record.get("branch"), str)):
        raise ValueError(f"invalid record {name}")
    return record


def _is_stale(runtime_dir, dir_fd, tip, url, branch):
    for name in os.listdir(dir_fd):
        if name == f"{tip}.json" or not RECORD_NAME.fullmatch(name):
            continue
        try:
            record = _read_record(runtime_dir, dir_fd, name)
        except Exception:
            continue  # an unrelated record that cannot be read does not decide this gate
        if record and record["remote_url"] == url and record["branch"] == branch:
            return True
    return False


def _gate_reason(runtime_dir, dir_fd, cwd, arguments):
    """Why `gh pr create` is denied, or None when it is allowed. `cwd` is None when a cd could not be resolved."""
    head = _head_option(arguments)
    if cwd is None or head == "":
        return "no branch to check: the working directory or the --head value cannot be resolved"
    if head is None:
        branch = _git_output(cwd, "symbolic-ref", "--short", "-q", "HEAD")
    else:
        branch = head.split(":", 1)[1] if ":" in head else head
    if not branch:
        return "no branch to check: not in a git repository, or HEAD is detached and there is no --head"
    tip = _git_output(cwd, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}^{{commit}}")
    if not tip:
        return f"push first: origin/{branch} does not exist in {cwd}. Push the branch, then run the audit."
    url = _git_output(cwd, "remote", "get-url", "origin", no_result=(2, 128))
    if url is None:
        raise RuntimeError("git remote get-url origin failed")
    record = _read_record(runtime_dir, dir_fd, f"{tip}.json")
    if record is None:
        if _is_stale(runtime_dir, dir_fd, tip, url, branch):
            return f"stale record: the audit of {branch} is for an older commit than {tip[:7]}. Run the audit again."
        return f"no record: no audit record for {branch} at {tip[:7]}. Run the audit."
    if record["remote_url"] != url:
        return f"remote mismatch: the record of {tip[:7]} is for {record['remote_url']}, not {url}."
    if record["result"] != "pass":
        return f"failed record: the audit of {branch} at {tip[:7]} failed. Report the failed items to the user."
    return None


def _dispatch_reason(runtime_dir, dir_fd, session_id):
    """Why a `worker-start` is denied, or None when the session has a passing pre-dispatch record. Raises for a record that is not valid."""
    name = PRE_DISPATCH_NAME % session_id
    text = runtime_dir.read_file(dir_fd, name)
    if text is None:
        return "no pre-dispatch record: no pre-dispatch audit for this session. Run the pre-dispatch audit, then dispatch."
    record = json.loads(text)
    if not isinstance(record, dict) or record.get("session_id") != session_id or record.get("result") not in ("pass", "fail"):
        raise ValueError(f"invalid record {name}")
    if record["result"] != "pass":
        return "failed pre-dispatch record: the pre-dispatch audit of this session failed. Report the failed items to the user."
    return None


def _substitution_bodies(word):
    """The (start, end) of each `$(...)` (to its matching parenthesis) and each backtick pair in a word; an unbalanced one is left out."""
    bodies, index = [], 0
    while index < len(word):
        if word.startswith("$(", index):
            depth, end = 1, index + 2
            while end < len(word) and depth:
                depth += (word[end] == "(") - (word[end] == ")")
                end += 1
            if depth == 0:
                bodies.append((index, end))
                index = end
                continue
        elif word[index] == "`" and "`" in word[index + 1:]:
            end = word.index("`", index + 1) + 1
            bodies.append((index, end))
            index = end
            continue
        index += 1
    return bodies


def _is_followed(body, segments):
    """Whether a substitution body splits into segments that are all parsed segments of the command: the gate has checked them already."""
    try:
        parts = [item for item in split_command(body) if isinstance(item, list)]
    except Exception:
        return False
    return bool(parts) and all(part in segments for part in parts)


def _segment_text(segment, segments):
    """The normalised text of a segment, without the substitution bodies that the gate has checked as segments."""
    words = []
    for word in segment:
        for start, end in reversed(_substitution_bodies(word)):
            if _is_followed(word[start + 2 if word[start] == "$" else start + 1:end - 1], segments):
                word = word[:start] + word[end:]
        words.append(word)
    return _normalise(" ".join(words))


def _segment_excess(form, segment, segments):
    """Whether a segment holds more of the form's text than it accounts for: its head, when the pattern sees it, accounts for one."""
    head = form.head(segment) if form.head else None
    accounted = 1 if head is not None and form.pattern.search(_normalise(" ".join(head))) else 0
    return len(form.pattern.findall(_segment_text(segment, segments))) > accounted


def _unchecked_reason(command, segments):
    """The deny reason when a gate finds more of its text in the command than it matched as segments, else None. The PR gate comes first."""
    for form in GATED_FORMS:
        reason = UNCHECKED_REASON % form.count_text + form.pointer
        matching = sum(form.segment(segment) for segment in segments)
        if form.pattern is None:
            if _occurrences(command, form.count_text) > matching:
                return reason
            continue
        if len(form.pattern.findall(_normalise(command))) > matching:  # whole text
            return reason
        if any(_segment_excess(form, segment, segments) for segment in segments):  # per segment
            return reason
    return None


def gate_reason(command, cwd, session_id=None):
    """The deny reason for a Bash command, or None to allow it."""
    command = _join_as_bash(command)  # so a continued command is one segment with all its words
    try:
        items = split_command(command)
    except Exception:
        # The command cannot be split into words, so no cd, --head or --retry-of can be read: a match is denied.
        for form in GATED_FORMS:
            if _raw_match(command, form):
                return form.unparsable_reason
        return None
    segments = [item for item in items if isinstance(item, list)]
    for segment in segments:  # the raw delete forms are denied here, before the early return and the record checks
        for form in GATED_FORMS:
            if form.denied and form.denied(segment):
                return form.deny_reason
    dispatches = sum(_is_dispatch(segment) for segment in segments)
    pr_matches = sum(_is_pr_create(segment) for segment in segments)  # help-only ones too
    pr_creates = sum(_is_gated_pr_create(segment) for segment in segments)
    # Bodies of command substitutions (`$(...)`, backticks) are not parsed. More occurrences of the text than matching segments,
    # together with a substitution marker, means the command may run gh pr create where the gate cannot follow it: fail closed.
    unfollowed = ("$(" in command or "`" in command) and _occurrences(command, PR_FORM.count_text) > pr_matches
    if not pr_creates and not dispatches:
        return UNFOLLOWED_REASON if unfollowed else _unchecked_reason(command, segments)
    if pr_creates and (not isinstance(cwd, str) or not cwd):
        return "hook input unreadable: no working directory for a matching command"
    dir_fd = None
    try:
        runtime_dir = _runtime()
        if dispatches and not runtime_dir.valid_session_id(session_id):
            return "hook input unreadable: no session id for a matching command"
        dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
        if dir_fd is None:
            return "unsafe runtime folder: the audit folder is not owned by you with mode 0700, or is a symlink"
        current, outer = cwd, []  # `outer` holds the directory to restore at each closing parenthesis
        for index, item in enumerate(items):
            if isinstance(item, str):
                for char in item:
                    if char == "(":
                        outer.append(current)
                    elif char == ")" and outer:
                        current = outer.pop()
                continue
            words = _command_words(item)
            if words[:1] == ["cd"]:
                before = _operator(items[index - 1]) if index else ""
                after = _operator(items[index + 1]) if index + 1 < len(items) else ""
                # In bash a cd in a pipeline or in the background runs in a subshell and does not move the commands after it.
                if before not in PIPE_OPERATORS and after not in PIPE_OPERATORS | {"&"}:
                    current = _after_cd(current, words)
            elif _is_gated_pr_create(item):
                reason = _gate_reason(runtime_dir, dir_fd, current, words[3:])
                if reason:
                    return reason
            elif _is_dispatch(item):
                reason = _dispatch_reason(runtime_dir, dir_fd, session_id)
                if reason:
                    return reason
        if unfollowed:
            return UNFOLLOWED_REASON
        return _unchecked_reason(command, segments)
    except Exception as error:
        return f"hook error: {error}"
    finally:
        if dir_fd is not None:
            os.close(dir_fd)


def cmd_pre_tool_use():
    try:
        raw = sys.stdin.buffer.read().decode("utf-8", "replace")
    except Exception:
        return 0
    try:
        data = json.loads(raw)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        # Unreadable input: the raw text is matched like an unparsable command.
        reason = "hook input unreadable: the hook input is not JSON" if any(_raw_match(raw, form) for form in GATED_FORMS) else None
    else:
        tool_input = data.get("tool_input")
        command = tool_input.get("command") if isinstance(tool_input, dict) else None
        if data.get("tool_name", "Bash") != "Bash" or not isinstance(command, str):
            return 0
        reason = gate_reason(command, data.get("cwd"), data.get("session_id"))
    if reason:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason}}))
    return 0


# ---- session registry: SessionStart ----

def cmd_session_start():
    import stat

    try:
        data = json.loads(sys.stdin.buffer.read().decode("utf-8"))
        session_id, transcript_path = data["session_id"], data["transcript_path"]
        runtime_dir = _runtime()
        if not runtime_dir.valid_session_id(session_id) or not isinstance(transcript_path, str) or not transcript_path:
            return 0
        line = json.dumps({"session_id": session_id, "transcript_path": transcript_path,
                           "started_at": _now()}) + "\n"
        encoded = line.encode("utf-8")
        if len(encoded) >= MAX_REGISTRY_LINE_BYTES:
            return 0
        dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
        if dir_fd is None:
            return 0
        try:
            file_fd = os.open(SESSIONS_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o600, dir_fd=dir_fd)
            try:
                if stat.S_ISREG(os.fstat(file_fd).st_mode):
                    os.write(file_fd, encoded)
            finally:
                os.close(file_fd)
        finally:
            os.close(dir_fd)
    except Exception:
        pass  # register nothing, print nothing
    return 0


def main(argv):
    if argv[:1] == ["ledger"]:
        return cmd_ledger(argv[1:])
    if argv[:1] == ["check"]:
        return cmd_check(argv[1:])
    if argv[:1] == ["record"]:
        return cmd_record(argv[1:])
    if argv == ["hook", "pre-tool-use"]:
        return cmd_pre_tool_use()
    if argv == ["hook", "session-start"]:
        return cmd_session_start()
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
