#!/usr/bin/env python3
# Workflow audit (spec #92, ticket #94). Standard library only; run as `python3 -I <path>/audit ...`.
#   audit record --worktree <path> --llm <file>   re-run S1, S2 and S8, read L1-L6, write <sha>.json for the pushed tip
#   audit hook pre-tool-use                       deny `gh pr create` without a passing record for the pushed tip
#   audit hook session-start                      register the session (id, transcript path, start time)
# Exit codes of `record`: 0 record written and passed, 1 record written and failed, 2 nothing written.
# Both hooks must never break a session: a hook error denies a command that matches the gate and changes nothing else.
import json
import os
import re
import shlex
import sys

FOLDER_NAME = "claude-workflow-audit"
CONTEXT_HANDOFF_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "context-handoff")
GIT_TIMEOUT_SECONDS = 20
EVIDENCE_LIMIT = 2000
L_EVIDENCE_LIMIT = 4000
L_ITEMS = ("L1", "L2", "L3", "L4", "L5", "L6")
SESSIONS_FILE = "sessions.jsonl"
MAX_REGISTRY_LINE_BYTES = 4096
UNFOLLOWED_REASON = "no branch to check: gh pr create inside a command substitution cannot be followed"
USAGE = "usage: audit record --worktree <path> --llm <file> | audit hook pre-tool-use | audit hook session-start"

# The ten types of skills/smart-commits/SKILL.md.
COMMIT_TYPES = ("feat", "fix", "refactor", "chore", "docs", "style", "test", "perf", "ci", "build")
HEADER = re.compile(r"(?:%s)(?:\([A-Za-z0-9._/-]+\))?!?: +\S" % "|".join(COMMIT_TYPES))
TRAILER = re.compile(r"\s*([A-Za-z][A-Za-z-]*)\s*:(.*)", re.DOTALL)
ATTRIBUTION_NAMED_KEYS = ("signed-off-by", "generated-by", "assisted-by", "reviewed-by", "authored-by", "created-by", "made-by")
ATTRIBUTION_NAME = re.compile(r"claude|anthropic|noreply@anthropic\.com", re.IGNORECASE)
GENERATED_WITH = re.compile(r"generated with.*claude", re.IGNORECASE)
ROBOT = "\U0001F916"

SEPARATOR_CHARS = frozenset("&|;()\n")
PIPE_OPERATORS = frozenset(("|", "|&"))
ENV_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
# Words that can stand before a command: shell keywords of compound commands, and wrappers that run the next word.
COMMAND_PREFIX_WORDS = frozenset(("!", "{", "if", "elif", "while", "until", "then", "do", "else", "time", "env", "command", "exec"))
UNRESOLVABLE_PATH = re.compile(r"[$`*?\[]")
RECORD_NAME = re.compile(r"[0-9a-f]{40}\.json")

# Claude Code versions the transcript reader is tested against; each needs a fixtures/session-<version>.jsonl.
TESTED_VERSIONS = ("2.1.301",)
TESTED_MAJOR_MINOR = frozenset(tuple(version.split(".")[:2]) for version in TESTED_VERSIONS)
READ_KINDS = frozenset(("user", "assistant", "system", "attachment"))
EDIT_TOOLS = frozenset(("Edit", "Write", "NotebookEdit"))
VERSION = re.compile(r"(\d+)\.(\d+)\.(\d+)")
CD_PREFIX = re.compile(r"cd\s+(\"[^\"]*\"|'[^']*'|\S+)\s*&&")
TEST_COMMAND_HEADING = "### Test command"


def _runtime():
    # Imported on first use, inside the callers' guards, so an import error follows the error rules of the hooks.
    # The real folder goes first on the search path, so that a module of the same name earlier on it cannot win.
    sys.path.insert(0, CONTEXT_HANDOFF_DIR)
    import runtime_dir

    return runtime_dir


def _git(cwd, *args):
    import subprocess  # imported here: the hook's common path never runs git

    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, errors="replace", timeout=GIT_TIMEOUT_SECONDS)


def _git_output(cwd, *args, no_result=(1, 128)):
    """The stripped stdout of a git call that succeeded, None for a status that git uses for "no result"
    (1 for a missing ref or a detached HEAD, 128 outside a repository). Any other status raises."""
    result = _git(cwd, *args)
    if result.returncode == 0:
        return result.stdout.strip()
    if result.returncode in no_result:
        return None
    raise RuntimeError(f"git {args[0]} exited with status {result.returncode}: {result.stderr.strip()}")


def _cut(text):
    return text if len(text) <= EVIDENCE_LIMIT else text[: EVIDENCE_LIMIT - 3] + "..."


def _count_pr_create(text):
    return " ".join(text.split()).count("gh pr create")


# ---- S8: conventional commits without attribution ----

def _attribution_line(message):
    for line in message.splitlines():
        trailer = TRAILER.fullmatch(line)
        if trailer:
            key, value = trailer.group(1).lower(), trailer.group(2)
            if key == "co-authored-by" or (key in ATTRIBUTION_NAMED_KEYS and ATTRIBUTION_NAME.search(value)):
                return line
        if GENERATED_WITH.search(line) or line.lstrip().startswith(ROBOT):
            return line
    return None


def _commit_problem(message):
    header = message.split("\n", 1)[0]
    if not HEADER.match(header):
        return f"header is not conventional: {header[:60]!r}"
    line = _attribution_line(message)
    if line is not None:
        return f"attribution line: {line.strip()[:60]!r}"
    return None


def check_s8(worktree):
    """Returns (passed, evidence)."""
    default = None
    for ref in ("refs/remotes/origin/HEAD", "refs/remotes/origin/main", "refs/remotes/origin/master"):
        if _git_output(worktree, "rev-parse", "--verify", "-q", ref + "^{commit}"):
            default = ref
            break
    if default is None:
        return False, "evidence unavailable: none of origin/HEAD, origin/main and origin/master exists"
    base = _git_output(worktree, "merge-base", default, "HEAD")
    if not base:
        return False, f"evidence unavailable: no merge base of {default} and HEAD"
    log = _git(worktree, "log", "-z", "--format=%H%n%B", f"{base}..HEAD")
    if log.returncode != 0:
        return False, f"evidence unavailable: git log failed: {log.stderr.strip()}"
    commits = [entry for entry in log.stdout.split("\0") if entry.strip()]
    problems = []
    for entry in commits:
        sha, _, message = entry.strip("\n").partition("\n")
        problem = _commit_problem(message)
        if problem:
            problems.append(f"{sha[:7]}: {problem}")
    if not problems:
        return True, f"{len(commits)} commits since {base[:7]}, all conventional, no attribution"
    shown = problems[:10]
    if len(problems) > 10:
        shown.append(f"and {len(problems) - 10} more")
    return False, _cut("\n".join(shown))


# ---- transcript reader: S1 and S2 ----

class Unavailable(Exception):
    """The evidence cannot be read: the affected items fail with "evidence unavailable: <reason>"."""

    def __str__(self):
        return f"evidence unavailable: {self.args[0]}"


def _inside(path, root):
    return path == root or path.startswith(root.rstrip("/") + "/")


def _instant(value, where):
    from datetime import datetime, timezone

    try:
        moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        raise Unavailable(f"missing or bad timestamp in {where}")
    return moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)


class Transcript:
    """The rows of one transcript file that S1 and S2 read."""

    def __init__(self, name):
        self.name = name
        self.calls = []      # dicts: index, tool, id, time, path or command, background, cwd
        self.results = {}    # tool_use_id -> list of is_error booleans
        self.notices = []    # texts that hold a task notification
        self.cwds = set()
        self.versions = set()


def _check_version(row, where):
    version = row.get("version")
    match = VERSION.fullmatch(version) if isinstance(version, str) else None
    if not match:  # the value itself is row content and stays out of the evidence
        raise Unavailable(f"missing or malformed Claude Code version in {where}")
    if match.groups()[:2] not in TESTED_MAJOR_MINOR:
        raise Unavailable(f"untested Claude Code version {version} in {where}")
    return version


def _text_blocks(content):
    if isinstance(content, str):
        return [content]
    return [block["text"] for block in content if block.get("type") == "text" and isinstance(block.get("text"), str)]


def _read_row(transcript, index, row):
    where = f"{transcript.name} row {index + 1}"
    if not isinstance(row, dict) or not isinstance(row.get("type"), str):
        raise Unavailable(f"unknown row shape in {where}")
    kind = row["type"]
    if kind not in READ_KINDS:
        return
    transcript.versions.add(_check_version(row, where))
    if isinstance(row.get("cwd"), str):
        transcript.cwds.add(row["cwd"])
    if kind == "attachment":
        attachment = row.get("attachment")
        if isinstance(attachment, dict) and attachment.get("type") == "queued_command" and isinstance(attachment.get("prompt"), str):
            transcript.notices.append(attachment["prompt"])
        return
    if kind == "system":
        return
    message = row.get("message")
    if not isinstance(message, dict):
        raise Unavailable(f"missing message in {where}")
    content = message.get("content")
    if isinstance(content, str) and kind == "user":
        blocks = []
        transcript.notices.append(content)
    elif isinstance(content, list) and all(isinstance(block, dict) and isinstance(block.get("type"), str) for block in content):
        blocks = content
        if kind == "user":  # a notification is read from user and attachment rows only
            transcript.notices.extend(_text_blocks(content))
    else:
        raise Unavailable(f"unknown content shape in {where}")
    for block in blocks:
        if kind == "user" and block["type"] == "tool_result":
            if not isinstance(block.get("tool_use_id"), str) or not isinstance(block.get("is_error", False), bool):
                raise Unavailable(f"bad tool_result in {where}")
            transcript.results.setdefault(block["tool_use_id"], []).append(block.get("is_error", False))
        elif kind == "assistant" and block["type"] == "tool_use":
            if not isinstance(block.get("id"), str) or not isinstance(block.get("name"), str) or not isinstance(block.get("input"), dict):
                raise Unavailable(f"bad tool_use in {where}")
            name, tool_input = block["name"], block["input"]
            if name not in EDIT_TOOLS and name != "Bash":
                continue
            call = {"index": index, "tool": name, "id": block["id"], "time": _instant(row.get("timestamp"), where),
                    "cwd": row.get("cwd") if isinstance(row.get("cwd"), str) else None}
            if name == "Bash":
                if not isinstance(tool_input.get("command"), str):
                    raise Unavailable(f"missing command in {where}")
                call["command"] = tool_input["command"]
                call["background"] = tool_input.get("run_in_background") is True
            else:
                keys = ("file_path", "notebook_path") if name == "NotebookEdit" else ("file_path",)
                path = next((tool_input[key] for key in keys if isinstance(tool_input.get(key), str) and tool_input[key]), None)
                if path is None:
                    raise Unavailable(f"missing {keys[0]} in {where}")
                if not os.path.isabs(path):
                    if call["cwd"] is None:
                        raise Unavailable(f"relative path without cwd in {where}")
                    path = os.path.join(call["cwd"], path)
                call["path"] = os.path.realpath(path)
            transcript.calls.append(call)


def _read_transcript(path, text):
    transcript = Transcript(os.path.basename(path))
    for index, line in enumerate(text.split("\n")):  # not splitlines(): U+2028 and others stay inside a row
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except ValueError:
            row = None
        _read_row(transcript, index, row)
    return transcript


def _registered_sessions(dir_fd):
    """(session_id, transcript_path) of each registered session, the first line in file order per id."""
    import stat

    runtime_dir = _runtime()
    try:
        file_fd = os.open(SESSIONS_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    except FileNotFoundError:
        return []
    except OSError:
        raise Unavailable("unreadable registry")
    try:
        if not stat.S_ISREG(os.fstat(file_fd).st_mode):
            raise Unavailable("unreadable registry")
        with os.fdopen(os.dup(file_fd), "rb") as handle:
            data = handle.read()
    except OSError:
        raise Unavailable("unreadable registry")
    finally:
        os.close(file_fd)
    sessions = {}
    for number, line in enumerate(data.decode("utf-8", "replace").split("\n"), 1):
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            entry = None
        if (not isinstance(entry, dict) or not runtime_dir.valid_session_id(entry.get("session_id"))
                or not isinstance(entry.get("transcript_path"), str) or not entry["transcript_path"]
                or not isinstance(entry.get("started_at"), str)):
            raise Unavailable(f"unreadable registry line {number}")
        sessions.setdefault(entry["session_id"], entry["transcript_path"])
    return list(sessions.items())


def _touches(transcript, spellings, root):
    for call in transcript.calls:
        if call["tool"] == "Bash":
            if any(re.search(re.escape(spelling) + r"(?![A-Za-z0-9._-])", call["command"]) for spelling in spellings):
                return True
        elif _inside(call["path"], root):
            return True
    return any(_inside(os.path.realpath(cwd), root) for cwd in transcript.cwds)


def _audited_transcripts(worktree, dir_fd):
    """The transcripts of every registered session that touches the worktree, and the versions read.
    Raises Unavailable when no session touches it or a transcript cannot be read."""
    root = os.path.realpath(worktree)
    spellings = {os.path.abspath(worktree), root}
    needles = {text for spelling in spellings for text in (spelling, json.dumps(spelling)[1:-1])}
    sessions = _registered_sessions(dir_fd)
    if not sessions:
        raise Unavailable("no registered session (empty or wiped registry)")
    audited = []
    for _, path in sessions:
        folder = os.path.splitext(path)[0] + "/subagents"
        paths = [path]
        if os.path.isdir(folder):
            paths += sorted(os.path.join(folder, name) for name in os.listdir(folder) if re.fullmatch(r"agent-.+\.jsonl", name))
        texts = []
        for file_path in paths:
            try:
                with open(file_path, "rb") as handle:
                    texts.append(handle.read().decode("utf-8", "replace"))
            except OSError as error:
                raise Unavailable(f"cannot read transcript {os.path.basename(file_path)}: {error.strerror}")
        if not any(needle in text for text in texts for needle in needles):
            continue  # speed rule: a transcript that never holds the path cannot touch the worktree
        transcripts = [_read_transcript(file_path, text) for file_path, text in zip(paths, texts)]
        if any(_touches(transcript, spellings, root) for transcript in transcripts):
            audited.append(transcripts)
    if not audited:
        raise Unavailable("no registered session touches the worktree")
    return audited


def _versions_note(audited):
    versions = sorted({v for transcripts in audited for t in transcripts for v in t.versions} - set(TESTED_VERSIONS))
    return "".join(f"; untested patch version {version}" for version in versions)


def _main_checkout(worktree):
    try:
        listing = _git_output(worktree, "worktree", "list", "--porcelain")
    except RuntimeError as problem:
        raise Unavailable(str(problem))
    paths = [os.path.realpath(line[len("worktree "):]) for line in (listing or "").splitlines() if line.startswith("worktree ")]
    if not paths:
        raise Unavailable("git worktree list gave no worktree")
    return paths[0], paths[1:]


def check_s1(worktree, audited):
    """Returns (passed, evidence)."""
    root = os.path.realpath(worktree)
    main, others = _main_checkout(worktree)
    if root == main:
        return False, "the audited worktree is the main checkout"
    found = [f"{t.name}: {c['path']}" for transcripts in audited for t in transcripts for c in t.calls
             if c["tool"] in EDIT_TOOLS and _inside(c["path"], main) and not any(_inside(c["path"], other) for other in others)]
    if not found:
        return True, f"{len(audited)} sessions audited, no edit in the main checkout"
    shown = found[:10]
    if len(found) > 10:
        shown.append(f"and {len(found) - 10} more")
    return False, "\n".join(shown)


def _declaration_text(worktree, path):
    listed = _git(worktree, "ls-tree", "HEAD", "--", path)
    if listed.returncode != 0:
        raise Unavailable(f"git ls-tree failed for {path}: {listed.stderr.strip()}")
    if not listed.stdout.strip():
        return None
    shown = _git(worktree, "show", f"HEAD:{path}")
    if shown.returncode != 0:
        raise Unavailable(f"git show failed for {path}: {shown.stderr.strip()}")
    return shown.stdout


def _sections(text):
    """The fenced blocks (trimmed content) of each `### Test command` section in a markdown text."""
    sections, current, fence, block = [], None, None, None
    for line in text.splitlines():
        ticks = re.match(r"`{3,}", line)
        if fence is not None:
            if ticks and len(ticks.group()) >= fence:
                fence = None
                if current is not None:
                    current.append("\n".join(block).strip())
            elif current is not None:
                block.append(line)
            continue
        if ticks:
            fence, block = len(ticks.group()), []
        elif line.rstrip() == TEST_COMMAND_HEADING:
            current = []
            sections.append(current)
        elif re.match(r"#{1,6} ", line):
            current = None
    if fence is not None and current is not None:
        current.append("\n".join(block).strip())  # a fence that is never closed runs to the end of the file
    return sections


def _declared_command(worktree):
    """The declared test command, or "none". Raises ValueError for a declaration problem."""
    sections = []
    for path in (".claude/CLAUDE.md", "CLAUDE.md"):
        text = _declaration_text(worktree, path)
        if text is not None:
            sections += _sections(text)
    if len(sections) != 1:
        raise ValueError(f"expected exactly one '{TEST_COMMAND_HEADING}' section in .claude/CLAUDE.md and CLAUDE.md, found {len(sections)}")
    if len(sections[0]) != 1 or not sections[0][0]:
        raise ValueError(f"the '{TEST_COMMAND_HEADING}' section needs exactly one non-empty fenced block, found {len(sections[0])}")
    return sections[0][0]


def _is_after(run, run_transcript, edit, edit_transcript):
    if run_transcript is edit_transcript:
        return run["index"] > edit["index"]
    return run["time"] > edit["time"]


def _notification_exit(texts, call_id):
    """None when no notification belongs to the call; else True when every one of them is `completed (exit code 0)`."""
    outcomes = []
    for text in texts:
        for chunk in text.split("<task-notification>")[1:]:
            ids = re.findall(r"<tool-use-id>(.*?)</tool-use-id>", chunk, re.DOTALL)
            if call_id not in [value.strip() for value in ids]:
                continue
            status = re.search(r"<status>(.*?)</status>", chunk, re.DOTALL)
            summary = re.search(r"<summary>(.*?)</summary>", chunk, re.DOTALL)
            if not status or not summary:
                raise Unavailable("a task notification for a declared test run lacks its status or summary")
            outcomes.append(status.group(1).strip() == "completed" and re.search(r"\(exit code 0\)\s*$", summary.group(1).strip()) is not None)
    return all(outcomes) if outcomes else None


def check_s2(worktree, audited):
    """Returns (passed, evidence)."""
    try:
        declared = _declared_command(worktree)
    except ValueError as problem:
        return False, str(problem)
    if declared == "none":
        return True, "no tests declared (`none`)"
    root = os.path.realpath(worktree)

    def normalised(call):
        command = call["command"].strip()
        prefix = CD_PREFIX.match(command)
        if prefix:
            target = prefix.group(1).strip("'\"")
            if not os.path.isabs(target) and call["cwd"]:
                target = os.path.join(call["cwd"], target)  # a relative path means the row's cwd, not the audit's
            if os.path.isabs(target) and os.path.realpath(target) == root:
                command = command[prefix.end():].strip()
        return command

    edits, runs = [], []
    for transcripts in audited:
        for transcript in transcripts:
            for call in transcript.calls:
                if call["tool"] in EDIT_TOOLS and _inside(call["path"], root):
                    edits.append((call, transcript))
                elif call["tool"] == "Bash" and declared in call["command"] and normalised(call) == declared:
                    runs.append((call, transcript, transcripts[0]))
    later = 0
    for run, transcript, main in runs:
        if not all(_is_after(run, transcript, edit, edit_transcript) for edit, edit_transcript in edits):
            continue
        later += 1
        if run["background"]:
            texts = list(transcript.notices) + ([] if transcript is main else list(main.notices))
            outcome = _notification_exit(texts, run["id"])
        else:
            results = transcript.results.get(run["id"])
            outcome = None if not results else not any(results)
        if outcome:
            return True, f"declared command ran after the last of {len(edits)} edits"
    if not runs:
        return False, "the declared command did not run"
    if not later:
        return False, "the declared command ran only before the last edit"
    return False, "the declared command ran after the last edit but failed or did not finish"


# ---- record ----

class Refusal(Exception):
    """`record` writes nothing and exits 2."""


def _load_llm(path):
    try:
        with open(path, "rb") as handle:
            data = json.loads(handle.read().decode("utf-8"))
    except (OSError, ValueError) as error:
        raise Refusal(f"malformed L input: cannot read {path}: {error}")
    if not isinstance(data, dict) or set(data) != set(L_ITEMS):
        raise Refusal("malformed L input: need an object with exactly the keys L1 to L6")
    items = []
    for name in L_ITEMS:
        verdict = data[name]
        if not isinstance(verdict, dict) or set(verdict) != {"result", "evidence"}:
            raise Refusal(f"malformed L input: {name} needs exactly result and evidence")
        evidence = verdict["evidence"]
        if verdict["result"] not in ("pass", "fail") or not isinstance(evidence, str) or not 1 <= len(evidence) <= L_EVIDENCE_LIMIT:
            raise Refusal(f"malformed L input: {name} needs result pass or fail and evidence of 1 to {L_EVIDENCE_LIMIT} characters")
        items.append({"id": name, "kind": "L", "result": verdict["result"], "evidence": evidence})
    return items


def _record_arguments(argv):
    values = {}
    for index in range(0, len(argv), 2):
        flag = argv[index]
        if flag not in ("--worktree", "--llm") or flag in values or index + 1 >= len(argv):
            raise Refusal(USAGE)
        values[flag] = argv[index + 1]
    if set(values) != {"--worktree", "--llm"}:
        raise Refusal(USAGE)
    return values["--worktree"], values["--llm"]


def _now():
    from datetime import datetime, timezone  # imported here: the hook's common path never needs the time

    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _transcript_items(worktree, dir_fd):
    """The S1 and S2 items. Evidence that cannot be read fails both with "evidence unavailable"."""
    try:
        audited = _audited_transcripts(worktree, dir_fd)
    except Unavailable as problem:
        return [{"id": name, "kind": "S", "result": "fail", "evidence": _cut(str(problem))} for name in ("S1", "S2")]
    note = _versions_note(audited)
    items = []
    for name, check in (("S1", check_s1), ("S2", check_s2)):
        try:
            passed, evidence = check(worktree, audited)
        except Unavailable as problem:
            passed, evidence = False, str(problem)
        items.append({"id": name, "kind": "S", "result": "pass" if passed else "fail", "evidence": _cut(evidence) + note})
    return items


def _record(argv):
    worktree, llm_path = _record_arguments(argv)
    l_items = _load_llm(llm_path)
    branch = _git_output(worktree, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        raise Refusal(f"no branch to record: {worktree} is not a git worktree or HEAD is detached")
    tip = _git_output(worktree, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}^{{commit}}")
    if not tip:
        raise Refusal(f"push first: origin/{branch} does not exist")
    if _git_output(worktree, "rev-parse", "HEAD") != tip:
        raise Refusal(f"push first: HEAD differs from origin/{branch}")
    remote_url = _git_output(worktree, "remote", "get-url", "origin", no_result=(2, 128))
    if not remote_url:
        raise Refusal("no remote URL for origin")
    runtime_dir = _runtime()
    dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
    if dir_fd is None:
        raise Refusal("unsafe runtime folder")
    try:
        items = _transcript_items(worktree, dir_fd)
        passed, evidence = check_s8(worktree)
        items.append({"id": "S8", "kind": "S", "result": "pass" if passed else "fail", "evidence": evidence})
        items += l_items
        result = "pass" if all(item["result"] == "pass" for item in items) else "fail"
        text = json.dumps({
            "sha": tip, "remote_url": remote_url, "branch": branch,
            "time": _now(), "items": items, "result": result,
        })
        if len(text) > runtime_dir.MAX_READ_BYTES:
            raise Refusal("record too large")
        runtime_dir.write_atomic(dir_fd, f"{tip}.json", text)
    finally:
        os.close(dir_fd)
    for item in items:
        print(item["id"], item["result"])
    print("result", result)
    return 0 if result == "pass" else 1


def cmd_record(argv):
    try:
        return _record(argv)
    except Refusal as refusal:
        print(refusal, file=sys.stderr)
    except Exception as error:
        print(f"cannot record: {error}", file=sys.stderr)
    return 2


# ---- gate: PreToolUse ----

def split_command(command):
    """The command as a list of items: a list of words for each segment, and the separator token between segments as a string.
    Raises ValueError for an unbalanced quote."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars="".join(sorted(SEPARATOR_CHARS)))
    lexer.whitespace_split = True
    lexer.whitespace = " \t\r"  # a newline is a separator, not whitespace
    lexer.commenters = ""  # shlex would drop the text after a `#`, even inside a word
    items, words = [], []
    for token in lexer:
        if token and set(token) <= SEPARATOR_CHARS:  # shlex joins adjacent separators into one token
            if words:
                items.append(words)
                words = []
            items.append(token)
        else:
            words.append(token)
    if words:
        items.append(words)
    return items


def _operator(separator):
    """A separator token without its parentheses and newlines: shlex joins adjacent separators, so `&\n` and `|(` are one token."""
    return "".join(char for char in separator if char not in "()\n")


def _command_words(segment):
    index = 0
    while index < len(segment) and (ENV_ASSIGNMENT.match(segment[index]) or segment[index] in COMMAND_PREFIX_WORDS):
        index += 1
    return segment[index:]


def _is_pr_create(segment):
    words = _command_words(segment)
    return len(words) >= 3 and os.path.basename(words[0]) == "gh" and words[1:3] == ["pr", "create"]


def _head_option(arguments):
    """The last --head/-H value, or None when absent."""
    head = None
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word in ("--head", "-H"):
            head = arguments[index + 1] if index + 1 < len(arguments) else ""
            index += 1
        elif word.startswith("--head="):
            head = word[len("--head="):]
        elif word.startswith("-H") and not word.startswith("--"):
            head = word[2:].removeprefix("=")
        index += 1
    return head


def _after_cd(cwd, segment):
    """The working directory after a `cd` segment; None when it cannot be resolved."""
    arguments = segment[1:]
    if cwd is None or len(arguments) != 1 or arguments[0].startswith("-") or UNRESOLVABLE_PATH.search(arguments[0]):
        return None
    return os.path.normpath(os.path.join(cwd, os.path.expanduser(arguments[0])))


def _read_record(runtime_dir, dir_fd, name):
    """The parsed record in `name`, None when it does not exist. Raises when it cannot be read or is not valid."""
    text = runtime_dir.read_file(dir_fd, name)
    if text is None:
        return None
    record = json.loads(text)
    if (not isinstance(record, dict) or record.get("sha") != name[:-len(".json")] or record.get("result") not in ("pass", "fail")
            or not isinstance(record.get("remote_url"), str) or not isinstance(record.get("branch"), str)):
        raise ValueError(f"invalid record {name}")
    return record


def _is_stale(runtime_dir, dir_fd, tip, url, branch):
    for name in os.listdir(dir_fd):
        if name == f"{tip}.json" or not RECORD_NAME.fullmatch(name):
            continue
        try:
            record = _read_record(runtime_dir, dir_fd, name)
        except Exception:
            continue  # an unrelated record that cannot be read does not decide this gate
        if record and record["remote_url"] == url and record["branch"] == branch:
            return True
    return False


def _gate_reason(runtime_dir, dir_fd, cwd, arguments):
    """Why `gh pr create` is denied, or None when it is allowed. `cwd` is None when a cd could not be resolved."""
    head = _head_option(arguments)
    if cwd is None or head == "":
        return "no branch to check: the working directory or the --head value cannot be resolved"
    if head is None:
        branch = _git_output(cwd, "symbolic-ref", "--short", "-q", "HEAD")
    else:
        branch = head.split(":", 1)[1] if ":" in head else head
    if not branch:
        return "no branch to check: not in a git repository, or HEAD is detached and there is no --head"
    tip = _git_output(cwd, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}^{{commit}}")
    if not tip:
        return f"push first: origin/{branch} does not exist in {cwd}. Push the branch, then run the audit."
    url = _git_output(cwd, "remote", "get-url", "origin", no_result=(2, 128))
    if url is None:
        raise RuntimeError("git remote get-url origin failed")
    record = _read_record(runtime_dir, dir_fd, f"{tip}.json")
    if record is None:
        if _is_stale(runtime_dir, dir_fd, tip, url, branch):
            return f"stale record: the audit of {branch} is for an older commit than {tip[:7]}. Run the audit again."
        return f"no record: no audit record for {branch} at {tip[:7]}. Run the audit."
    if record["remote_url"] != url:
        return f"remote mismatch: the record of {tip[:7]} is for {record['remote_url']}, not {url}."
    if record["result"] != "pass":
        return f"failed record: the audit of {branch} at {tip[:7]} failed. Report the failed items to the user."
    return None


def gate_reason(command, cwd):
    """The deny reason for a Bash command, or None to allow it."""
    try:
        items = split_command(command)
    except Exception:
        # The command cannot be split into words, so no cd or --head can be read: a match is denied.
        if _count_pr_create(command):
            return "no branch to check: the command cannot be parsed"
        return None
    matches = sum(1 for item in items if isinstance(item, list) and _is_pr_create(item))
    # Bodies of command substitutions (`$(...)`, backticks) are not parsed. More occurrences of the text than matching segments,
    # together with a substitution marker, means the command may run gh pr create where the gate cannot follow it: fail closed.
    unfollowed = ("$(" in command or "`" in command) and _count_pr_create(command) > matches
    if not matches:
        return UNFOLLOWED_REASON if unfollowed else None
    if not isinstance(cwd, str) or not cwd:
        return "hook input unreadable: no working directory for a matching command"
    dir_fd = None
    try:
        runtime_dir = _runtime()
        dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
        if dir_fd is None:
            return "unsafe runtime folder: the audit folder is not owned by you with mode 0700, or is a symlink"
        current, outer = cwd, []  # `outer` holds the directory to restore at each closing parenthesis
        for index, item in enumerate(items):
            if isinstance(item, str):
                for char in item:
                    if char == "(":
                        outer.append(current)
                    elif char == ")" and outer:
                        current = outer.pop()
                continue
            words = _command_words(item)
            if words[:1] == ["cd"]:
                before = _operator(items[index - 1]) if index else ""
                after = _operator(items[index + 1]) if index + 1 < len(items) else ""
                # In bash a cd in a pipeline or in the background runs in a subshell and does not move the commands after it.
                if before not in PIPE_OPERATORS and after not in PIPE_OPERATORS | {"&"}:
                    current = _after_cd(current, words)
            elif _is_pr_create(item):
                reason = _gate_reason(runtime_dir, dir_fd, current, words[3:])
                if reason:
                    return reason
        if unfollowed:
            return UNFOLLOWED_REASON
        return None
    except Exception as error:
        return f"hook error: {error}"
    finally:
        if dir_fd is not None:
            os.close(dir_fd)


def cmd_pre_tool_use():
    try:
        raw = sys.stdin.buffer.read().decode("utf-8", "replace")
    except Exception:
        return 0
    try:
        data = json.loads(raw)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        # Unreadable input: the raw text is matched like an unparsable command.
        reason = "hook input unreadable: the hook input is not JSON" if _count_pr_create(raw) else None
    else:
        tool_input = data.get("tool_input")
        command = tool_input.get("command") if isinstance(tool_input, dict) else None
        if data.get("tool_name", "Bash") != "Bash" or not isinstance(command, str):
            return 0
        reason = gate_reason(command, data.get("cwd"))
    if reason:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason}}))
    return 0


# ---- session registry: SessionStart ----

def cmd_session_start():
    import stat

    try:
        data = json.loads(sys.stdin.buffer.read().decode("utf-8"))
        session_id, transcript_path = data["session_id"], data["transcript_path"]
        runtime_dir = _runtime()
        if not runtime_dir.valid_session_id(session_id) or not isinstance(transcript_path, str) or not transcript_path:
            return 0
        line = json.dumps({"session_id": session_id, "transcript_path": transcript_path,
                           "started_at": _now()}) + "\n"
        encoded = line.encode("utf-8")
        if len(encoded) >= MAX_REGISTRY_LINE_BYTES:
            return 0
        dir_fd = runtime_dir.open_runtime_dir(runtime_dir.runtime_dir_path(FOLDER_NAME))
        if dir_fd is None:
            return 0
        try:
            file_fd = os.open(SESSIONS_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o600, dir_fd=dir_fd)
            try:
                if stat.S_ISREG(os.fstat(file_fd).st_mode):
                    os.write(file_fd, encoded)
            finally:
                os.close(file_fd)
        finally:
            os.close(dir_fd)
    except Exception:
        pass  # register nothing, print nothing
    return 0


def main(argv):
    if argv[:1] == ["record"]:
        return cmd_record(argv[1:])
    if argv == ["hook", "pre-tool-use"]:
        return cmd_pre_tool_use()
    if argv == ["hook", "session-start"]:
        return cmd_session_start()
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
